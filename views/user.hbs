<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>{{title}}</title>
  <meta name="description" content={{description}} />

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@200;300;400;500;600;700&display=swap" rel="stylesheet" />
  
  <meta property="og:type" content="website">
  <meta property="og:title" content="{{siteName}}">
  <meta property="og:description" content={{description}}>
  <meta property="og:url" content={{siteUrl}}>
  <meta property="og:image" content={{logo}}>

  <meta name="google-site-verification" content="dy0y0cIwQW1IauaAWDPb4J1VnlvMXBPLL6Sml2NBCYI" />
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:title" content={{siteName}}>
  <meta name="twitter:description" content={{title}}>
  <meta name="twitter:image" content={{logo}}>
  <meta name="robots" content="index,follow">

  <link rel="canonical" href={{canonical}}>
  <link rel="icon" href="/logo-white.png" />
  <link rel="apple-touch-icon" href="/logo-white.png" />
   <link rel="preload" as="image" href={{logo}} />

  <script src="https://unpkg.com/lucide@latest"></script>
  <script src="javascripts/user.js"></script>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.0.2/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-EVSTQN3/azprG1Anm3QDgpJLIm9Nao0Yz1ztcQTwFspd3yD65VohhpuuCOmLASjC" crossorigin="anonymous">
  <link rel="stylesheet" href="stylesheets/user.css">

</head>
<body>

  <!-- 1. TOP ANNOUNCEMENT BAR -->
  <aside class="announcement-bar" aria-label="Promotions">
    <div class="announcement-controls">
      <div class="currency-selector-top" onclick="openCurrencyModal()" title="Select Currency">
        <span id="topCurrencyFlag">🇮🇳</span>
        <span id="topCurrencyCode" style="font-weight: 700;">INR</span>
        <i data-lucide="chevron-down" style="width: 12px; height: 12px;"></i>
      </div>
    </div>
    <div class="announcement-content">
      <span>Worldwide Express Shipping </span>
    </div>
    <div class="announcement-controls">
      <button class="theme-toggle-btn" onclick="toggleTheme()" id="themeToggleBtn" title="Switch Theme">
        <i data-lucide="sun" id="themeIconSun" style="width: 13px; height: 13px; display: none;"></i>
        <i data-lucide="moon" id="themeIconMoon" style="width: 13px; height: 13px;"></i>
        <span id="themeLabel">Dark</span>
      </button>
    </div>
  </aside>

  <!-- 2. SITE HEADER & NAVIGATION -->
  <header class="site-header">
    <div class="nav-container">
      
      <!-- Nav Left (Links) -->
      <nav class="nav-left" aria-label="Main navigation">
        <button class="mobile-menu-btn icon-action-btn" onclick="toggleMobileNav()" aria-label="Open menu">
          <i data-lucide="menu"></i>
        </button>
        <ul class="nav-links">
          <li><a href="#" class="nav-link active" onclick="filterByGender('all', event)">View Collection</a></li>
          <li><a href="" class="nav-link" onclick="filterByGender('men', event)">Men</a></li>
          <li><a href="#" class="nav-link" onclick="filterByGender('women', event)">Women</a></li>
        </ul>
      </nav>

      <!-- Center Logo (Dynamic: logo-white.png in dark, logo.png in light) -->
      <div class="brand-logo-wrap">
        <a href="/" aria-label="Qalidotae Homepage">
          <img src="/logo-white.png" alt="Qalidotae Dresses" class="brand-logo-img" id="headerLogoImg" />
        </a>
      </div>

      <!-- Nav Right (Search, Account, Cart) -->
      <div class="nav-right">
        <button class="icon-action-btn" onclick="focusSearch()" title="Search Garments">
          <i data-lucide="search"></i>
        </button>

        <button class="icon-action-btn" onclick="handleAccountClick()" id="accountBtn" title="My Account">
          <i data-lucide="user"></i>
        </button>

        <button class="icon-action-btn" onclick="openCartDrawer()" title="Shopping Bag">
          <i data-lucide="shopping-bag"></i>
          <span class="cart-badge" id="cartCountBadge">0</span>
        </button>
      </div>

    </div>
  </header>

  <!-- MOBILE NAVIGATION DRAWER -->
  <div class="cart-drawer-overlay mobile-drawer-overlay" id="mobileNavOverlay" onclick="toggleMobileNav()">
    <aside class="mobile-nav-drawer" onclick="event.stopPropagation()" aria-label="Mobile Navigation">
      <div class="cart-header">
        <div class="brand-logo-wrap">
          <img src="/logo-white.png" alt="Qalidotae" class="brand-logo-img" id="mobileDrawerLogoImg" style="height: 38px;" />
        </div>
        <button class="modal-close-btn" style="position: static;" onclick="toggleMobileNav()" aria-label="Close menu">
          <i data-lucide="x"></i>
        </button>
      </div>
      <div class="mobile-nav-content">
        <div class="mobile-nav-group">
          <div class="mobile-nav-label">DOTAE NAVIGATION</div>
          <a href="/" class="mobile-nav-link active" onclick="filterByGender('all', event); toggleMobileNav();">
            <i data-lucide="sparkles"></i>
            <span>All Collections</span>
          </a>
          <a href="#" class="mobile-nav-link" onclick="filterByGender('men', event); toggleMobileNav();">
            <i data-lucide="user"></i>
            <span>Men's Collection</span>
          </a>
          <a href="#" class="mobile-nav-link" onclick="filterByGender('women', event); toggleMobileNav();">
            <i data-lucide="heart"></i>
            <span>Women's Collection</span>
          </a>
          <a href="/products" class="mobile-nav-link" onclick="toggleMobileNav();">
            <i data-lucide="grid"></i>
            <span>Full Garment Catalog</span>
          </a>
          <a href="#" class="mobile-nav-link" onclick="openTrackOrderModal(event); toggleMobileNav();">
            <i data-lucide="truck"></i>
            <span>Track Order Status</span>
          </a>
        </div>

        <div class="mobile-nav-preferences">
          <div class="mobile-nav-label">PREFERENCES</div>
          <button class="btn-outline mobile-pref-btn" onclick="openCurrencyModal()">
            <i data-lucide="globe"></i>
            <span>Currency: <strong id="mobileCurrencyText">AED</strong></span>
          </button>
          <button class="btn-outline mobile-pref-btn" onclick="toggleTheme()">
            <i data-lucide="moon"></i>
            <span>Toggle Theme</span>
          </button>
        </div>
      </div>
    </aside>
  </div>

  <!-- 3. HERO EDITORIAL SECTION -->
  <section class="hero-section">
    <div class="hero-container">
      <span class="hero-subtitle"><i data-lucide="award" style="width: 14px; height: 14px;"></i> Heritage Reframed for the Modern Era</span>
      <h1 class="hero-title">The Pinnacle of <em>Middle Eastern</em> Luxury</h1>
      <p class="hero-description">
        Bridges the gap between classic Arabic drapery, intricate embroidery, and modern minimalist silhouettes. Designed for those who express identity through bold, refined wardrobe choices.
      </p>
      <div class="hero-cta-group">
        <button class="btn-gold" onclick="filterByGender('men')">
          <span>Explore Men's Thobes</span>
          <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
        </button>
        <button class="btn-outline" onclick="filterByGender('women')">
          <span>Explore Women's Abayas</span>
        </button>
      </div>
    </div>
  </section>

  <!-- 4. TRUST & LUXURY ASSURANCE BAR -->
  <section class="trust-bar-section col-12 w-100">
    <div class="trust-bar-wrapper col-12">
      <div class="trust-bar" id="trustBarCarousel">
        <div class="trust-card active col-12">
          <div class="trust-icon"><i data-lucide="banknote"></i></div>
          <div class="trust-text">
            <div class="trust-title">Cash On Delivery</div>
            <div class="trust-desc">Inspect & pay upon arrival at your doorstep</div>
          </div>
        </div>
        <div class="trust-card col-12">
          <div class="trust-icon"><i data-lucide="shield-check"></i></div>
          <div class="trust-text">
            <div class="trust-title">Master Tailored</div>
            <div class="trust-desc">Pure hand-finished stitching </div>
          </div>
        </div>
        <div class="trust-card col-12">
          <div class="trust-icon"><i data-lucide="plane"></i></div>
          <div class="trust-text">
            <div class="trust-title">Express Delivery</div>
            <div class="trust-desc">Dispatched in temperature-controlled casing</div>
          </div>
        </div>
        <div class="trust-card col-12">
          <div class="trust-icon"><i data-lucide="refresh-cw"></i></div>
          <div class="trust-text">
            <div class="trust-title">7-Day Bespoke Fit Exchange</div>
            <div class="trust-desc">Guaranteed size perfection & Cloth Quality</div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <!-- 5. MAIN PRODUCTS CATALOG SECTION -->
  <main class="catalog-section" id="catalogSection">
    
    <div class="catalog-header">
      <div>
        <h2 class="section-title">Explore Seasonal Collection</h2>
        <p class="section-subtitle" id="productCountSubtitle">Displaying available authentic garments</p>
      </div>
    </div>

    <!-- Controls: Gender tabs, Search, Sort, Type & Colour Dual Filters -->
    <div class="catalog-controls">
      <div class="controls-top-row">
        <div class="gender-tabs">
          <button class="gender-tab active" onclick="filterByGender('all', event)">All</button>
          <button class="gender-tab" onclick="filterByGender('men', event)">Men</button>
          <button class="gender-tab" onclick="filterByGender('women', event)">Women</button>
          <button class="gender-tab" onclick="filterByGender('unisex', event)">Unisex</button>
        </div>

        <div class="search-sort-group">
          <div class="search-input-wrap">
            <input type="text" class="search-input" placeholder="Search thobes, abayas, fabrics..." id="catalogSearchInput" oninput="handleSearchInput()" />
          </div>

          <select class="sort-select" id="sortSelect" onchange="handleSortChange()">
            <option value="newest">Sort: Newest Editions</option>
            <option value="price_asc">Price: Low to High</option>
            <option value="price_desc">Price: High to Low</option>
          </select>
        </div>
      </div>

      <!-- Part 1: Shop by Type / Categories (Premium Dynamic Auto-Moving Cards) -->
      <div class="filter-part-block">
        <div class="filter-part-header">
          <div class="filter-part-title">
            <i data-lucide="layout-grid" style="width: 14px; height: 14px; color: var(--gold-primary);"></i>
            <span>Explore by Categories</span>
          </div>
          <div class="filter-part-actions">
            <span class="filter-part-active-badge" id="activeCategoryBadge">All Garments</span>
            <a href="/products" class="filter-see-all-link">
              <span>View All</span>
              <i data-lucide="arrow-up-right" style="width: 12px; height: 12px;"></i>
            </a>
          </div>
        </div>
        <div class="premium-cards-scroll-wrap" id="categoryScrollWrap">
          <div class="premium-cards-track" id="categoryCardsContainer">
            <!-- Injected dynamically via renderDynamicCategoryCards() -->
          </div>
        </div>
      </div>

      <!-- Part 2: Shop by Colour (Premium Dynamic Auto-Moving Cards) -->
      <div class="filter-part-block">
        <div class="filter-part-header">
          <div class="filter-part-title">
            <i data-lucide="palette" style="width: 14px; height: 14px; color: var(--gold-primary);"></i>
            <span>Pick Your Colour</span>
          </div>
          <div class="filter-part-actions">
            <span class="filter-part-active-badge" id="activeColorBadge">All Colours</span>
            <a href="/products" class="filter-see-all-link">
              <span>View All</span>
              <i data-lucide="arrow-up-right" style="width: 12px; height: 12px;"></i>
            </a>
          </div>
        </div>
        <div class="premium-cards-scroll-wrap" id="colorScrollWrap">
          <div class="premium-cards-track" id="colorCardsContainer">
            <!-- Injected dynamically via renderDynamicColorCards() -->
          </div>
        </div>
      </div>
    </div>

    <!-- Products Grid (Filled Dynamically) -->
    <div class="products-grid" id="productsGridContainer">
      <!-- Loading Skeleton / Items will be injected here -->
      <div style="grid-column: 1 / -1; text-align: center; padding: 60px 0; color: var(--text-dim);">
        <i data-lucide="loader-2" class="spin" style="width: 32px; height: 32px; margin: 0 auto 12px;"></i>
        <div>Collecting our master creations for you...</div>
      </div>
    </div>

    <!-- Progressive Load Sentinel & Explore More Action Button -->
    <div id="catalogFooterAction" class="catalog-footer-action">
      <div id="catalogLoadingIndicator" class="catalog-scroll-loader" style="display: none;">
        <i data-lucide="loader-2" class="spin" style="width: 20px; height: 20px; color: var(--gold-primary);"></i>
        <span>Introducing more creations...</span>
      </div>
      <div id="exploreMoreContainer" class="explore-more-container" style="display: none;">
        <a href="/products" class="btn-gold explore-more-btn" onclick="goToFullCatalog(event)">
          <span>Explore More Creations</span>
          <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
        </a>
      </div>
    </div>

  </main>

  <!-- 6. PRODUCT DETAIL MODAL -->
  <div class="modal-overlay" id="productModalOverlay" onclick="closeProductModal()">
    <div class="modal-box" onclick="event.stopPropagation()">
      <button class="modal-close-btn" onclick="closeProductModal()" aria-label="Close modal">
        <i data-lucide="x"></i>
      </button>
      <div class="product-detail-layout" id="productDetailContent">
        <!-- Dynamic content filled via openProductModal(id) -->
      </div>
    </div>
  </div>

  <!-- 7. SIZE GUIDE MODAL -->
  <div class="modal-overlay" id="sizeGuideModalOverlay" onclick="closeSizeGuideModal()">
    <div class="modal-box size-guide-modal" onclick="event.stopPropagation()">
      <button class="modal-close-btn" onclick="closeSizeGuideModal()">
        <i data-lucide="x"></i>
      </button>
      <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 16px;">
        <h3 class="font-serif" style="font-size: 1.8rem; color: var(--text-main);">Qalidotae Sizing Guide</h3>
        <div style="display: flex; gap: 4px; background: var(--bg-input); padding: 3px; border-radius: var(--radius-sm);">
          <button id="unitBtnCm" class="filter-chip active" style="padding: 4px 10px; font-size: 0.72rem;" onclick="toggleSizingUnit('cm')">CM</button>
          <button id="unitBtnIn" class="filter-chip" style="padding: 4px 10px; font-size: 0.72rem;" onclick="toggleSizingUnit('in')">Inches</button>
        </div>
      </div>
      <p style="font-size: 0.82rem; color: var(--text-secondary); margin-bottom: 12px;">
        Not sure about your fit? Check our Size Guide to find your perfect match.
      </p>
      
      <table class="size-guide-table" id="sizeGuideTable">
        <!-- Injected via renderSizeGuide() -->
      </table>

      <div style="background: var(--bg-surface-elevated); padding: 14px; border-radius: var(--radius-sm); font-size: 0.78rem; color: var(--text-dim); border: 1px solid var(--border-color);">
        <strong style="color: var(--gold-primary);">Sizing Advice:</strong> If you're between sizes, we recommend sizing up for a relaxed fit or sizing down for a tailored look.
      </div>
    </div>
  </div>

  <!-- 8. CART DRAWER OVERLAY & PANEL -->
  <div class="cart-drawer-overlay" id="cartDrawerOverlay" onclick="closeCartDrawer()">
    <aside class="cart-drawer" onclick="event.stopPropagation()" aria-label="Shopping cart">
      <div class="cart-header">
        <div class="cart-title">
          <i data-lucide="shopping-bag" style="color: var(--gold-primary);"></i>
          <span>Your Bag</span>
        </div>
        <button class="modal-close-btn" style="position: static;" onclick="closeCartDrawer()">
          <i data-lucide="x"></i>
        </button>
      </div>

      <div class="cart-items-list" id="cartItemsContainer">
        <!-- Injected via renderCart() -->
      </div>

      <div class="cart-summary" id="cartSummarySection">
        <div class="summary-row">
          <span>Subtotal</span>
          <span id="cartSubtotalText">INR 0</span>
        </div>
        <div class="summary-row">
          <span>Express Courier Shipping</span>
          <span style="color: #10b981; font-weight: 600;">Within 7 Days</span>
        </div>
        <div class="summary-row">
          <span>Payment Method</span>
          <span style="color: var(--gold-primary); font-weight: 600;">Cash On Delivery</span>
        </div>
        <div class="summary-row total">
          <span>Estimated Total</span>
          <span id="cartTotalText" style="color: var(--gold-primary);">INR 0</span>
        </div>
        <button class="btn-gold" style="width: 100%; justify-content: center; margin-top: 8px;" onclick="startCheckoutFlow()">
          <span>Proceed to Checkout</span>
          <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
        </button>
      </div>
    </aside>
  </div>

  <!-- 9. AUTHENTICATION MODAL (SIGN IN / REGISTER) -->
  <div class="modal-overlay" id="authModalOverlay" onclick="closeAuthModal()">
    <div class="modal-box auth-modal-box" onclick="event.stopPropagation()">
      <button class="modal-close-btn" onclick="closeAuthModal()">
        <i data-lucide="x"></i>
      </button>
      
      <div class="auth-tabs">
        <div class="auth-tab active" id="tabSignIn" onclick="switchAuthTab('signin')">Sign In</div>
        <div class="auth-tab" id="tabRegister" onclick="switchAuthTab('register')">Create Account</div>
      </div>

      <!-- Sign In Form -->
      <form id="signInForm" onsubmit="handleSignInSubmit(event)">
        <div class="form-group">
          <label class="form-label">Email Address</label>
          <input type="email" class="form-input" id="loginEmail" required placeholder="client@example.com" />
        </div>
        <div class="form-group">
          <label class="form-label">Password</label>
          <input type="password" class="form-input" id="loginPassword" required placeholder="••••••••" />
        </div>
        <button type="submit" class="btn-gold" style="width: 100%; justify-content: center; margin-top: 12px;" id="loginSubmitBtn">
          Sign In & Continue
        </button>
      </form>

      <!-- Register Form -->
      <form id="registerForm" style="display: none;" onsubmit="handleRegisterSubmit(event)">
        <div class="form-group">
          <label class="form-label">Full Name *</label>
          <input type="text" class="form-input" id="regFullName" required placeholder="e.g. Sheikh Tariq Al Nuaimi" />
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Email Address *</label>
            <input type="email" class="form-input" id="regEmail" required placeholder="client@example.com" />
          </div>
          <div class="form-group">
            <label class="form-label">Password *</label>
            <input type="password" class="form-input" id="regPassword" required placeholder="••••••••" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Phone Number *</label>
            <input type="tel" class="form-input" id="regPhone" required placeholder="+971 50 123 4567" />
          </div>
          <div class="form-group">
            <label class="form-label">WhatsApp Number</label>
            <input type="tel" class="form-input" id="regWhatsapp" placeholder="+971 50 123 4567" />
          </div>
        </div>
        <div class="form-group">
          <label class="form-label">Gender</label>
          <select class="form-input" id="regGender">
            <option value="male">Male</option>
            <option value="female">Female</option>
            <option value="other">Other</option>
          </select>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Villa / House / Apt *</label>
            <input type="text" class="form-input" id="regHousename" required placeholder="Villa 14, Palm Views" />
          </div>
          <div class="form-group">
            <label class="form-label">Place / Area *</label>
            <input type="text" class="form-input" id="regPlace" required placeholder="Palm Jumeirah" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">City *</label>
            <input type="text" class="form-input" id="regCity" required placeholder="Dubai" />
          </div>
          <div class="form-group">
            <label class="form-label">Country *</label>
            <input type="text" class="form-input" id="regCountry" required value="UAE" />
          </div>
        </div>
        <div class="form-row">
          <div class="form-group">
            <label class="form-label">Landmark</label>
            <input type="text" class="form-input" id="regLandmark" placeholder="Near Nakheel Mall" />
          </div>
          <div class="form-group">
            <label class="form-label">Postal Code</label>
            <input type="text" class="form-input" id="regPostalCode" placeholder="11223" />
          </div>
        </div>

        <button type="submit" class="btn-gold" style="width: 100%; justify-content: center; margin-top: 12px;" id="regSubmitBtn">
          Create Account & Proceed
        </button>
      </form>
    </div>
  </div>

  <!-- 10. CHECKOUT CONFIRMATION MODAL -->
  <div class="modal-overlay" id="checkoutModalOverlay" onclick="closeCheckoutModal()">
    <div class="modal-box checkout-modal-box" onclick="event.stopPropagation()">
      <button class="modal-close-btn" onclick="closeCheckoutModal()">
        <i data-lucide="x"></i>
      </button>

      <h3 class="font-serif" style="font-size: 2rem; color: var(--text-main); margin-bottom: 6px;">Make Your Order</h3>
      <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 20px;">
        Review your delivery address and confirm order placement with Cash On Delivery.
      </p>

      <!-- Delivery Destination Summary -->
      <div style="background: var(--bg-surface-elevated); padding: 18px; border-radius: var(--radius-md); border: 1px solid var(--border-color); margin-bottom: 16px;">
        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;">
          <strong style="font-size: 0.88rem; color: var(--gold-primary); text-transform: uppercase;">Shipping Address</strong>
          <span style="font-size: 0.75rem; color: var(--text-dim);" id="checkoutClientName">User</span>
        </div>
        <div id="checkoutAddressText" style="font-size: 0.85rem; color: var(--text-main); line-height: 1.5;">
          Loading destination...
        </div>
      </div>

      <!-- Cash On Delivery Highlight -->
      <div class="cod-badge-box">
        <i data-lucide="badge-dollar-sign" style="width: 28px; height: 28px; color: var(--gold-primary); flex-shrink: 0;"></i>
        <div>
          <div style="font-weight: 700; color: var(--text-main); font-size: 0.9rem;">Payment Method: Cash On Delivery (COD)</div>
          <div style="font-size: 0.75rem; color: var(--text-dim);">Zero prepayment required. Pay cash to our courier agent upon inspecting your package.</div>
        </div>
      </div>

      <!-- Shipping Notes -->
      <div class="form-group">
        <label class="form-label">Special Delivery Instructions / Gate Notes</label>
        <textarea class="form-textarea" id="checkoutShippingNotes" rows="2" placeholder="e.g. Call upon arrival, leave at security desk..."></textarea>
      </div>

      <!-- Order Items Breakdown -->
      <div id="checkoutOrderItemsList" style="max-height: 160px; overflow-y: auto; margin-bottom: 16px;">
        <!-- Rendered items -->
      </div>

      <div class="summary-row total" style="margin-bottom: 18px;">
        <span>Total Payable (Cash On Delivery):</span>
        <span id="checkoutTotalAmountText" style="color: var(--gold-primary);">AED 0</span>
      </div>

      <button class="btn-gold" style="width: 100%; justify-content: center; padding: 15px;" onclick="placeCodOrder()" id="placeOrderBtn">
        <i data-lucide="check-circle-2"></i>
        <span>Confirm Order with Cash On Delivery</span>
      </button>
    </div>
  </div>

  <!-- 11. ORDER SUCCESS MODAL -->
  <div class="modal-overlay" id="orderSuccessModalOverlay">
    <div class="modal-box" style="max-width: 540px; text-align: center; padding: 40px 32px;" onclick="event.stopPropagation()">
      <div style="width: 64px; height: 64px; border-radius: 50%; background: rgba(16, 185, 129, 0.15); color: #10b981; display: flex; align-items: center; justify-content: center; margin: 0 auto 16px;">
        <i data-lucide="check" style="width: 36px; height: 36px;"></i>
      </div>

      <h3 class="font-serif" style="font-size: 2.2rem; color: var(--text-main); margin-bottom: 6px;">Order Confirmed</h3>
      <p style="font-size: 0.9rem; color: var(--text-secondary); margin-bottom: 20px;">
        Thank you for choosing Qalidotae. Your optimal match have been scheduled for dispatch.
      </p>

      <div style="background: var(--bg-surface-elevated); padding: 16px; border-radius: var(--radius-sm); border: 1px solid var(--border-color); margin-bottom: 24px; text-align: left;">
        <div style="display: flex; justify-content: space-between; margin-bottom: 6px; font-size: 0.85rem;">
          <span style="color: var(--text-dim);">Order Reference:</span>
          <strong style="color: var(--gold-primary); font-family: monospace;" id="successOrderNumber">QAL-0000</strong>
        </div>
        <div style="display: flex; justify-content: space-between; font-size: 0.85rem;">
          <span style="color: var(--text-dim);">Payment Mode:</span>
          <strong style="color: #10b981;">Cash On Delivery</strong>
        </div>
      </div>

      <div style="display: flex; gap: 12px;">
        <button class="btn-gold" style="flex: 1; justify-content: center;" onclick="trackPlacedOrder()">
          <i data-lucide="map-pin"></i> Track Order
        </button>
        <button class="btn-outline" style="flex: 1; justify-content: center;" onclick="closeOrderSuccessModal()">
          Continue Browsing
        </button>
      </div>
    </div>
  </div>

  <!-- 12. TRACK ORDER MODAL & TIMELINE -->
  <div class="modal-overlay" id="trackingModalOverlay" onclick="closeTrackOrderModal()">
    <div class="modal-box tracking-modal-box" onclick="event.stopPropagation()">
      <button class="modal-close-btn" onclick="closeTrackOrderModal()">
        <i data-lucide="x"></i>
      </button>

      <h3 class="font-serif" style="font-size: 2rem; color: var(--text-main); margin-bottom: 6px;">Track Garment Delivery</h3>
      <p style="font-size: 0.85rem; color: var(--text-secondary); margin-bottom: 20px;">
        Enter your Order Number to view real-time atelier progress and courier dispatch status.
      </p>

      <div style="display: flex; gap: 8px; margin-bottom: 24px;">
        <input type="text" class="form-input" id="trackOrderInput" placeholder="e.g. QAL-2026-1001" />
        <button class="btn-gold" onclick="executeOrderTracking()" style="padding: 10px 20px;">
          <i data-lucide="search"></i> Track
        </button>
      </div>

      <div id="trackingResultContainer">
        <!-- Timeline & item details injected here -->
      </div>
    </div>
  </div>

  <!-- 13. USER PROFILE & MY ORDERS MODAL -->
  <div class="modal-overlay" id="profileModalOverlay" onclick="closeProfileModal()">
    <div class="modal-box" style="max-width: 680px; padding: 32px;" onclick="event.stopPropagation()">
      <button class="modal-close-btn" onclick="closeProfileModal()">
        <i data-lucide="x"></i>
      </button>

      <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
        <div>
          <h3 class="font-serif" style="font-size: 2rem; color: var(--text-main);" id="profileHeaderName">User Profile</h3>
          <p style="font-size: 0.8rem; color: var(--gold-primary);" id="profileHeaderEmail">yourEmail@example.com</p>
        </div>
        <button class="btn-outline" style="padding: 6px 14px; font-size: 0.78rem;" onclick="handleLogout()">
          <i data-lucide="log-out"></i> Sign Out
        </button>
      </div>

      <div style="display: flex; border-bottom: 1px solid var(--border-color); margin-bottom: 20px;">
        <button class="auth-tab active" id="profileTabOrders" onclick="switchProfileTab('orders')">My Orders</button>
        <button class="auth-tab" id="profileTabAddress" onclick="switchProfileTab('address')">Shipping Details</button>
      </div>

      <div id="myOrdersTabContent">
        <div id="myOrdersListContainer">
          <!-- Injected user orders -->
        </div>
      </div>

      <div id="myAddressTabContent" style="display: none;">
        <form onsubmit="handleProfileUpdate(event)">
          <div class="form-group">
            <label class="form-label">Full Name</label>
            <input type="text" class="form-input" id="profFullName" required />
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Phone Number</label>
              <input type="tel" class="form-input" id="profPhone" />
            </div>
            <div class="form-group">
              <label class="form-label">WhatsApp Number</label>
              <input type="tel" class="form-input" id="profWhatsapp" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Villa / House / Apt</label>
              <input type="text" class="form-input" id="profHousename" />
            </div>
            <div class="form-group">
              <label class="form-label">Place / Area</label>
              <input type="text" class="form-input" id="profPlace" />
            </div>
          </div>
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">City</label>
              <input type="text" class="form-input" id="profCity" />
            </div>
            <div class="form-group">
              <label class="form-label">Country</label>
              <input type="text" class="form-input" id="profCountry" />
            </div>
          </div>
          <button type="submit" class="btn-gold" style="width: 100%; justify-content: center; margin-top: 12px;">
            Update Shipping Address
          </button>
        </form>
      </div>

    </div>
  </div>

  <!-- 14. CURRENCY SELECTOR MODAL -->
  <div class="modal-overlay" id="currencyModalOverlay" onclick="closeCurrencyModal()">
    <div class="modal-box" style="max-width: 440px; padding: 28px;" onclick="event.stopPropagation()">
      <button class="modal-close-btn" onclick="closeCurrencyModal()">
        <i data-lucide="x"></i>
      </button>
      <h3 class="font-serif" style="font-size: 1.8rem; margin-bottom: 6px;">Select Currency</h3>
      <p style="font-size: 0.82rem; color: var(--text-dim); margin-bottom: 18px;">
        Prices are dynamically converted using live ECB Frankfurter exchange rates.
      </p>
      <div style="display: flex; flex-direction: column; gap: 8px;" id="currencyListContainer">
        <!-- Injected list of currencies -->
      </div>
    </div>
  </div>

