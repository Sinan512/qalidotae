<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no" />
  <title>Qalidotae — Luxury Arabic Fashion & Atelier</title>
  <meta name="description" content="Qalidotae luxury thobe and abaya atelier. Premium handcrafted Emirati, Moroccan, and Saudi garments, made with pure silk and spun cotton with worldwide Cash On Delivery." />

  <!-- Fonts & Icons -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,500;0,600;0,700;1,400&family=Inter:wght@200;300;400;500;600;700&display=swap" rel="stylesheet" />
  <script src="https://unpkg.com/lucide@latest"></script>

  <style>
    /* CSS RESET & VARIABLES */
    *, *::before, *::after {
      box-sizing: border-box;
      margin: 0;
      padding: 0;
    }

    :root {
      /* Shared Tokens */
      --font-display: 'Cormorant Garamond', Georgia, serif;
      --font-sans: 'Inter', -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
      --transition-smooth: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
      --transition-slow: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
      --radius-sm: 4px;
      --radius-md: 8px;
      --radius-lg: 14px;
      --radius-full: 9999px;
      --shadow-sm: 0 2px 8px rgba(0,0,0,0.08);
      --shadow-md: 0 8px 24px rgba(0,0,0,0.12);
      --shadow-lg: 0 16px 48px rgba(0,0,0,0.22);
      --gold-primary: #d4af37;
      --gold-light: #f3e5ab;
      --gold-dark: #aa851c;
      --gold-gradient: linear-gradient(135deg, #d4af37 0%, #aa851c 100%);
    }

    /* DARK THEME (DEFAULT) */
    html[data-theme="dark"] {
      --bg-body: #0a0a0d;
      --bg-surface: #121217;
      --bg-surface-elevated: #181820;
      --bg-surface-card: #14141a;
      --bg-input: #1b1b24;
      --border-color: rgba(255, 255, 255, 0.08);
      --border-color-focus: rgba(212, 175, 55, 0.5);
      --text-main: #f5f5f7;
      --text-secondary: #a1a1aa;
      --text-dim: #71717a;
      --badge-bg: rgba(212, 175, 55, 0.12);
      --badge-text: #e8d08d;
      --nav-bg: rgba(10, 10, 13, 0.88);
      --drawer-bg: #121218;
      --modal-bg: #14141c;
      --card-hover-border: rgba(212, 175, 55, 0.35);
      --overlay-bg: rgba(0, 0, 0, 0.75);
    }

    /* LIGHT THEME */
    html[data-theme="light"] {
      --bg-body: #f8f6f0;
      --bg-surface: #ffffff;
      --bg-surface-elevated: #ffffff;
      --bg-surface-card: #ffffff;
      --bg-input: #f2efe9;
      --border-color: rgba(0, 0, 0, 0.08);
      --border-color-focus: rgba(170, 133, 28, 0.5);
      --text-main: #141416;
      --text-secondary: #52525b;
      --text-dim: #71717a;
      --badge-bg: rgba(170, 133, 28, 0.1);
      --badge-text: #966f0e;
      --nav-bg: rgba(248, 246, 240, 0.92);
      --drawer-bg: #ffffff;
      --modal-bg: #ffffff;
      --card-hover-border: rgba(170, 133, 28, 0.35);
      --overlay-bg: rgba(0, 0, 0, 0.5);
    }

    body {
      font-family: var(--font-sans);
      background-color: var(--bg-body);
      color: var(--text-main);
      line-height: 1.5;
      overflow-x: hidden;
      min-height: 100vh;
      display: flex;
      flex-direction: column;
      transition: background-color 0.3s ease, color 0.3s ease;
    }

    a {
      color: inherit;
      text-decoration: none;
    }

    button, input, select, textarea {
      font-family: inherit;
      color: inherit;
      border: none;
      outline: none;
      background: none;
    }

    img {
      max-width: 100%;
      display: block;
    }

    /* TYPOGRAPHY */
    .font-serif {
      font-family: var(--font-display);
    }

    .tracking-luxury {
      letter-spacing: 0.15em;
      text-transform: uppercase;
    }

    .gold-text {
      color: var(--gold-primary);
    }

    /* TOP ANNOUNCEMENT BAR */
    .announcement-bar {
      background: #000000;
      color: var(--gold-light);
      font-size: 0.75rem;
      letter-spacing: 0.08em;
      padding: 8px 16px;
      display: flex;
      justify-content: space-between;
      align-items: center;
      border-bottom: 1px solid rgba(212, 175, 55, 0.2);
    }

    .announcement-content {
      flex: 1;
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .announcement-controls {
      display: flex;
      align-items: center;
      gap: 14px;
      font-size: 0.72rem;
    }

    .currency-selector-top {
      display: flex;
      align-items: center;
      gap: 4px;
      cursor: pointer;
      padding: 2px 6px;
      border-radius: var(--radius-sm);
      background: rgba(255, 255, 255, 0.06);
    }

    .theme-toggle-btn {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      padding: 3px 8px;
      border-radius: var(--radius-full);
      background: rgba(255, 255, 255, 0.08);
      color: #ffffff;
      cursor: pointer;
      font-size: 0.7rem;
      transition: var(--transition-smooth);
    }

    .theme-toggle-btn:hover {
      background: var(--gold-primary);
      color: #000000;
    }

    /* HEADER & MAIN NAVIGATION */
    .site-header {
      position: sticky;
      top: 0;
      z-index: 50;
      background: var(--nav-bg);
      backdrop-filter: blur(16px);
      -webkit-backdrop-filter: blur(16px);
      border-bottom: 1px solid var(--border-color);
      transition: var(--transition-smooth);
    }

    .nav-container {
      max-width: 1360px;
      margin: 0 auto;
      padding: 12px 24px;
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 20px;
    }

    .nav-left {
      display: flex;
      align-items: center;
      gap: 28px;
      flex: 1;
    }

    .nav-links {
      display: flex;
      align-items: center;
      gap: 24px;
      list-style: none;
    }

    .nav-link {
      font-size: 0.85rem;
      font-weight: 500;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-secondary);
      transition: var(--transition-smooth);
      position: relative;
      padding: 6px 0;
    }

    .nav-link:hover, .nav-link.active {
      color: var(--text-main);
    }

    .nav-link::after {
      content: '';
      position: absolute;
      bottom: 0;
      left: 0;
      width: 0%;
      height: 2px;
      background: var(--gold-primary);
      transition: width 0.25s ease;
    }

    .nav-link:hover::after, .nav-link.active::after {
      width: 100%;
    }

    /* BRAND LOGO */
    .brand-logo-wrap {
      display: flex;
      align-items: center;
      justify-content: center;
      text-align: center;
    }

    .brand-logo-img {
      height: 48px;
      width: auto;
      object-fit: contain;
      transition: transform 0.3s ease;
    }

    .brand-logo-img:hover {
      transform: scale(1.03);
    }

    .nav-right {
      display: flex;
      align-items: center;
      justify-content: flex-end;
      gap: 16px;
      flex: 1;
    }

    .icon-action-btn {
      position: relative;
      display: flex;
      align-items: center;
      justify-content: center;
      width: 40px;
      height: 40px;
      border-radius: var(--radius-full);
      color: var(--text-main);
      cursor: pointer;
      transition: var(--transition-smooth);
    }

    .icon-action-btn:hover {
      background: var(--bg-surface-elevated);
      color: var(--gold-primary);
    }

    .cart-badge {
      position: absolute;
      top: 4px;
      right: 4px;
      background: var(--gold-primary);
      color: #000000;
      font-size: 0.65rem;
      font-weight: 700;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      display: flex;
      align-items: center;
      justify-content: center;
      box-shadow: 0 2px 6px rgba(0,0,0,0.3);
    }

    .mobile-menu-btn {
      display: none;
    }

    /* HERO EDITORIAL SECTION */
    .hero-section {
      position: relative;
      background: linear-gradient(180deg, var(--bg-surface) 0%, var(--bg-body) 100%);
      padding: 60px 24px 70px;
      border-bottom: 1px solid var(--border-color);
      overflow: hidden;
      text-align: center;
    }

    .hero-container {
      max-width: 960px;
      margin: 0 auto;
      position: relative;
      z-index: 2;
    }

    .hero-subtitle {
      font-size: 0.8rem;
      letter-spacing: 0.25em;
      text-transform: uppercase;
      color: var(--gold-primary);
      margin-bottom: 12px;
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .hero-title {
      font-family: var(--font-display);
      font-size: clamp(2.4rem, 5.5vw, 4.4rem);
      font-weight: 300;
      line-height: 1.1;
      letter-spacing: 0.02em;
      color: var(--text-main);
      margin-bottom: 16px;
    }

    .hero-title em {
      font-style: italic;
      color: var(--gold-primary);
    }

    .hero-description {
      font-size: 1.05rem;
      color: var(--text-secondary);
      max-width: 640px;
      margin: 0 auto 28px;
      font-weight: 300;
      line-height: 1.6;
    }

    .hero-cta-group {
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 16px;
      flex-wrap: wrap;
    }

    .btn-gold {
      background: var(--gold-gradient);
      color: #000000;
      font-weight: 600;
      font-size: 0.85rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 13px 28px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: var(--transition-smooth);
      box-shadow: 0 4px 16px rgba(212, 175, 55, 0.25);
      display: inline-flex;
      align-items: center;
      gap: 8px;
    }

    .btn-gold:hover {
      transform: translateY(-2px);
      box-shadow: 0 6px 24px rgba(212, 175, 55, 0.4);
    }

    .btn-outline {
      border: 1px solid var(--border-color);
      color: var(--text-main);
      font-size: 0.85rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 13px 28px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: var(--transition-smooth);
      background: var(--bg-surface);
    }

    .btn-outline:hover {
      border-color: var(--gold-primary);
      color: var(--gold-primary);
    }

    /* TRUST BADGES BAR */
    .trust-bar {
      max-width: 1360px;
      margin: 0 auto;
      padding: 24px;
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 20px;
      border-bottom: 1px solid var(--border-color);
    }

    .trust-card {
      display: flex;
      align-items: center;
      gap: 14px;
      padding: 12px;
    }

    .trust-icon {
      width: 42px;
      height: 42px;
      border-radius: var(--radius-md);
      background: var(--badge-bg);
      color: var(--gold-primary);
      display: flex;
      align-items: center;
      justify-content: center;
      flex-shrink: 0;
    }

    .trust-title {
      font-size: 0.88rem;
      font-weight: 600;
      color: var(--text-main);
    }

    .trust-desc {
      font-size: 0.75rem;
      color: var(--text-dim);
    }

    /* CATALOG SECTION */
    .catalog-section {
      max-width: 1360px;
      margin: 0 auto;
      padding: 40px 24px 80px;
      width: 100%;
      flex: 1;
    }

    .catalog-header {
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      gap: 20px;
      margin-bottom: 28px;
      flex-wrap: wrap;
    }

    .section-title {
      font-family: var(--font-display);
      font-size: 2.2rem;
      font-weight: 400;
      color: var(--text-main);
    }

    .section-subtitle {
      font-size: 0.85rem;
      color: var(--text-dim);
      margin-top: 4px;
    }

    /* FILTERS & SEARCH CONTROLS */
    .catalog-controls {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin-bottom: 32px;
      background: var(--bg-surface);
      padding: 16px 20px;
      border-radius: var(--radius-md);
      border: 1px solid var(--border-color);
    }

    .controls-top-row {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 16px;
      flex-wrap: wrap;
    }

    .gender-tabs {
      display: flex;
      align-items: center;
      gap: 6px;
      background: var(--bg-input);
      padding: 4px;
      border-radius: var(--radius-sm);
    }

    .gender-tab {
      padding: 6px 16px;
      font-size: 0.8rem;
      font-weight: 500;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      border-radius: var(--radius-sm);
      cursor: pointer;
      color: var(--text-secondary);
      transition: var(--transition-smooth);
    }

    .gender-tab.active {
      background: var(--gold-primary);
      color: #000000;
      font-weight: 600;
    }

    .search-sort-group {
      display: flex;
      align-items: center;
      gap: 12px;
      flex: 1;
      justify-content: flex-end;
      min-width: 280px;
    }

    .search-input-wrap {
      position: relative;
      flex: 1;
      max-width: 320px;
    }

    .search-input-wrap i {
      position: absolute;
      left: 12px;
      top: 50%;
      transform: translateY(-50%);
      color: var(--text-dim);
      pointer-events: none;
      width: 16px;
      height: 16px;
    }

    .search-input {
      width: 100%;
      background: var(--bg-input);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 8px 12px 8px 36px;
      font-size: 0.85rem;
      color: var(--text-main);
      transition: var(--transition-smooth);
    }

    .search-input:focus {
      border-color: var(--gold-primary);
    }

    .sort-select {
      background: var(--bg-input);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 8px 14px;
      font-size: 0.82rem;
      color: var(--text-main);
      cursor: pointer;
    }

    .category-filter-chips {
      display: flex;
      align-items: center;
      gap: 8px;
      overflow-x: auto;
      padding-bottom: 4px;
    }

    .filter-chip {
      font-size: 0.75rem;
      letter-spacing: 0.04em;
      padding: 5px 12px;
      border-radius: var(--radius-full);
      background: var(--bg-input);
      color: var(--text-secondary);
      cursor: pointer;
      white-space: nowrap;
      border: 1px solid transparent;
      transition: var(--transition-smooth);
    }

    .filter-chip:hover {
      border-color: var(--border-color);
      color: var(--text-main);
    }

    .filter-chip.active {
      background: rgba(212, 175, 55, 0.15);
      border-color: var(--gold-primary);
      color: var(--gold-primary);
      font-weight: 600;
    }

    /* PRODUCT GRID */
    .products-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 28px;
    }

    /* PRODUCT CARD WITH AUTO-SLIDING FRONT & BACK HOVER */
    .product-card {
      background: var(--bg-surface-card);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-md);
      overflow: hidden;
      display: flex;
      flex-direction: column;
      transition: var(--transition-smooth);
      position: relative;
      cursor: pointer;
    }

    .product-card:hover {
      transform: translateY(-6px);
      border-color: var(--card-hover-border);
      box-shadow: var(--shadow-lg);
    }

    .product-media-wrap {
      position: relative;
      width: 100%;
      padding-top: 133.33%; /* 3:4 Aspect Ratio */
      background: #111115;
      overflow: hidden;
    }

    /* Dual Image Auto-Slide & Hover View Container */
    .product-images-slider {
      position: absolute;
      top: 0;
      left: 0;
      width: 200%;
      height: 100%;
      display: flex;
      transition: transform 0.6s cubic-bezier(0.25, 1, 0.5, 1);
    }

    .product-slide-img {
      width: 50%;
      height: 100%;
      object-fit: cover;
      object-position: center;
      transition: transform 0.7s cubic-bezier(0.25, 1, 0.5, 1);
    }

    /* When hovered, slide to back image automatically and apply subtle zoom */
    .product-card:hover .product-images-slider {
      transform: translateX(-50%);
    }

    .product-card:hover .product-slide-img {
      transform: scale(1.05);
    }

    /* Indicator dots for front/back */
    .slide-dots {
      position: absolute;
      bottom: 12px;
      left: 50%;
      transform: translateX(-50%);
      display: flex;
      gap: 6px;
      z-index: 3;
      pointer-events: none;
    }

    .slide-dot {
      width: 6px;
      height: 6px;
      border-radius: 50%;
      background: rgba(255, 255, 255, 0.4);
      transition: var(--transition-smooth);
    }

    .slide-dot.active {
      background: var(--gold-primary);
      width: 16px;
      border-radius: 4px;
    }

    .product-card:hover .slide-dot:first-child {
      background: rgba(255, 255, 255, 0.4);
      width: 6px;
      border-radius: 50%;
    }

    .product-card:hover .slide-dot:last-child {
      background: var(--gold-primary);
      width: 16px;
      border-radius: 4px;
    }

    /* Card Badges */
    .card-badges {
      position: absolute;
      top: 12px;
      left: 12px;
      display: flex;
      flex-direction: column;
      gap: 6px;
      z-index: 3;
    }

    .card-badge {
      font-size: 0.68rem;
      font-weight: 600;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      padding: 3px 8px;
      border-radius: var(--radius-sm);
      background: rgba(0, 0, 0, 0.65);
      color: #ffffff;
      backdrop-filter: blur(4px);
    }

    .card-badge.gold {
      background: var(--gold-primary);
      color: #000000;
    }

    .card-badge.stock-low {
      background: #e11d48;
      color: #ffffff;
    }

    /* Quick Action Buttons on Hover */
    .card-quick-actions {
      position: absolute;
      bottom: 14px;
      right: 14px;
      left: 14px;
      display: flex;
      gap: 8px;
      z-index: 4;
      opacity: 0;
      transform: translateY(10px);
      transition: var(--transition-smooth);
    }

    .product-card:hover .card-quick-actions {
      opacity: 1;
      transform: translateY(0);
    }

    .btn-quick-view {
      flex: 1;
      background: rgba(0, 0, 0, 0.85);
      color: #ffffff;
      font-size: 0.75rem;
      font-weight: 600;
      letter-spacing: 0.05em;
      text-transform: uppercase;
      padding: 9px 12px;
      border-radius: var(--radius-sm);
      backdrop-filter: blur(8px);
      border: 1px solid rgba(255, 255, 255, 0.15);
      cursor: pointer;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
      transition: var(--transition-smooth);
    }

    .btn-quick-view:hover {
      background: var(--gold-primary);
      color: #000000;
      border-color: var(--gold-primary);
    }

    /* Product Card Content */
    .product-content {
      padding: 16px;
      display: flex;
      flex-direction: column;
      flex: 1;
    }

    .product-type-gender {
      font-size: 0.72rem;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--gold-primary);
      margin-bottom: 4px;
      font-weight: 500;
    }

    .product-title {
      font-family: var(--font-display);
      font-size: 1.25rem;
      font-weight: 600;
      line-height: 1.25;
      color: var(--text-main);
      margin-bottom: 8px;
    }

    .product-sizes-preview {
      display: flex;
      align-items: center;
      gap: 4px;
      margin-bottom: 12px;
      flex-wrap: wrap;
    }

    .size-pill {
      font-size: 0.65rem;
      padding: 2px 6px;
      border-radius: 3px;
      background: var(--bg-input);
      color: var(--text-dim);
      font-weight: 500;
    }

    .product-footer-row {
      margin-top: auto;
      display: flex;
      align-items: flex-end;
      justify-content: space-between;
      padding-top: 10px;
      border-top: 1px solid var(--border-color);
    }

    .product-price-box {
      display: flex;
      flex-direction: column;
    }

    .price-converted {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-main);
    }

    .price-original-sub {
      font-size: 0.7rem;
      color: var(--text-dim);
    }

    /* MODAL OVERLAY & DRAWERS */
    .modal-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--overlay-bg);
      backdrop-filter: blur(8px);
      z-index: 100;
      display: flex;
      align-items: center;
      justify-content: center;
      padding: 20px;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .modal-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .modal-box {
      background: var(--modal-bg);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-lg);
      max-width: 900px;
      width: 100%;
      max-height: 90vh;
      overflow-y: auto;
      position: relative;
      box-shadow: var(--shadow-lg);
      transform: scale(0.95);
      transition: transform 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    }

    .modal-overlay.active .modal-box {
      transform: scale(1);
    }

    .modal-close-btn {
      position: absolute;
      top: 16px;
      right: 16px;
      width: 36px;
      height: 36px;
      border-radius: 50%;
      background: var(--bg-surface-elevated);
      color: var(--text-main);
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      z-index: 10;
      transition: var(--transition-smooth);
    }

    .modal-close-btn:hover {
      background: var(--gold-primary);
      color: #000000;
    }

    /* PRODUCT DETAILS MODAL VIEW */
    .product-detail-layout {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 32px;
      padding: 32px;
    }

    .detail-gallery {
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .detail-main-img-wrap {
      position: relative;
      width: 100%;
      padding-top: 130%;
      background: #111116;
      border-radius: var(--radius-md);
      overflow: hidden;
      border: 1px solid var(--border-color);
      cursor: zoom-in;
    }

    .detail-main-img {
      position: absolute;
      top: 0;
      left: 0;
      width: 100%;
      height: 100%;
      object-fit: cover;
      transition: transform 0.3s ease;
    }

    .detail-main-img:hover {
      transform: scale(1.15);
    }

    .detail-thumbnails {
      display: flex;
      gap: 10px;
    }

    .detail-thumb {
      width: 70px;
      height: 90px;
      border-radius: var(--radius-sm);
      overflow: hidden;
      border: 2px solid transparent;
      cursor: pointer;
      opacity: 0.6;
      transition: var(--transition-smooth);
    }

    .detail-thumb.active, .detail-thumb:hover {
      opacity: 1;
      border-color: var(--gold-primary);
    }

    .detail-thumb img {
      width: 100%;
      height: 100%;
      object-fit: cover;
    }

    .detail-info {
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .detail-tag {
      font-size: 0.75rem;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--gold-primary);
      font-weight: 600;
    }

    .detail-name {
      font-family: var(--font-display);
      font-size: 2.2rem;
      font-weight: 400;
      line-height: 1.15;
      color: var(--text-main);
    }

    .detail-price-row {
      display: flex;
      align-items: baseline;
      gap: 12px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--border-color);
    }

    .detail-price-main {
      font-size: 1.6rem;
      font-weight: 700;
      color: var(--text-main);
    }

    .detail-price-inr {
      font-size: 0.85rem;
      color: var(--text-dim);
    }

    .detail-section-label {
      font-size: 0.8rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      color: var(--text-secondary);
      display: flex;
      justify-content: space-between;
      align-items: center;
      margin-bottom: 8px;
    }

    .size-guide-trigger {
      color: var(--gold-primary);
      font-size: 0.75rem;
      text-decoration: underline;
      cursor: pointer;
    }

    .size-selector-grid {
      display: grid;
      grid-template-columns: repeat(6, 1fr);
      gap: 8px;
    }

    .size-btn {
      padding: 10px 0;
      text-align: center;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      font-weight: 600;
      cursor: pointer;
      color: var(--text-main);
      background: var(--bg-surface-elevated);
      transition: var(--transition-smooth);
    }

    .size-btn:hover {
      border-color: var(--gold-primary);
      color: var(--gold-primary);
    }

    .size-btn.active {
      background: var(--gold-primary);
      border-color: var(--gold-primary);
      color: #000000;
    }

    .color-swatches {
      display: flex;
      gap: 8px;
      flex-wrap: wrap;
    }

    .color-chip {
      padding: 6px 14px;
      font-size: 0.78rem;
      border-radius: var(--radius-full);
      background: var(--bg-surface-elevated);
      border: 1px solid var(--border-color);
      cursor: pointer;
      transition: var(--transition-smooth);
    }

    .color-chip.active {
      border-color: var(--gold-primary);
      background: rgba(212, 175, 55, 0.15);
      color: var(--gold-primary);
      font-weight: 600;
    }

    .detail-desc {
      font-size: 0.88rem;
      color: var(--text-secondary);
      line-height: 1.6;
    }

    .qty-row {
      display: flex;
      align-items: center;
      gap: 16px;
    }

    .qty-stepper {
      display: flex;
      align-items: center;
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      background: var(--bg-surface-elevated);
    }

    .qty-btn {
      width: 38px;
      height: 38px;
      display: flex;
      align-items: center;
      justify-content: center;
      cursor: pointer;
      color: var(--text-main);
      transition: var(--transition-smooth);
    }

    .qty-btn:hover {
      color: var(--gold-primary);
    }

    .qty-display {
      width: 44px;
      text-align: center;
      font-size: 0.9rem;
      font-weight: 600;
    }

    .detail-actions {
      display: flex;
      flex-direction: column;
      gap: 10px;
      margin-top: 8px;
    }

    .btn-buy-cod {
      width: 100%;
      background: #000000;
      color: var(--gold-primary);
      border: 1px solid var(--gold-primary);
      font-size: 0.85rem;
      font-weight: 700;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      padding: 14px;
      border-radius: var(--radius-sm);
      cursor: pointer;
      transition: var(--transition-smooth);
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 8px;
    }

    .btn-buy-cod:hover {
      background: var(--gold-primary);
      color: #000000;
    }

    .cod-guarantee-note {
      font-size: 0.72rem;
      color: var(--text-dim);
      text-align: center;
      display: flex;
      align-items: center;
      justify-content: center;
      gap: 6px;
    }

    /* SIZE GUIDE MODAL */
    .size-guide-modal {
      max-width: 680px;
      padding: 32px;
    }

    .size-guide-table {
      width: 100%;
      border-collapse: collapse;
      margin: 16px 0;
      font-size: 0.85rem;
    }

    .size-guide-table th, .size-guide-table td {
      padding: 10px 14px;
      text-align: center;
      border-bottom: 1px solid var(--border-color);
    }

    .size-guide-table th {
      background: var(--bg-surface-elevated);
      color: var(--gold-primary);
      font-weight: 600;
    }

    /* CART SLIDE-OVER DRAWER */
    .cart-drawer-overlay {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background: var(--overlay-bg);
      backdrop-filter: blur(6px);
      z-index: 120;
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
    }

    .cart-drawer-overlay.active {
      opacity: 1;
      visibility: visible;
    }

    .cart-drawer {
      position: fixed;
      top: 0;
      right: 0;
      bottom: 0;
      width: 100%;
      max-width: 440px;
      background: var(--drawer-bg);
      border-left: 1px solid var(--border-color);
      z-index: 121;
      display: flex;
      flex-direction: column;
      transform: translateX(100%);
      transition: transform 0.35s cubic-bezier(0.16, 1, 0.3, 1);
      box-shadow: var(--shadow-lg);
    }

    .cart-drawer-overlay.active .cart-drawer {
      transform: translateX(0);
    }

    .cart-header {
      padding: 20px 24px;
      border-bottom: 1px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: space-between;
    }

    .cart-title {
      font-family: var(--font-display);
      font-size: 1.5rem;
      font-weight: 500;
      display: flex;
      align-items: center;
      gap: 8px;
    }

    .cart-items-list {
      flex: 1;
      overflow-y: auto;
      padding: 20px 24px;
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .cart-item-card {
      display: flex;
      gap: 14px;
      padding: 14px;
      border-radius: var(--radius-md);
      background: var(--bg-surface);
      border: 1px solid var(--border-color);
      position: relative;
    }

    .cart-item-thumb {
      width: 72px;
      height: 96px;
      border-radius: var(--radius-sm);
      object-fit: cover;
      background: #111116;
      flex-shrink: 0;
    }

    .cart-item-details {
      flex: 1;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .cart-item-name {
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--text-main);
      line-height: 1.2;
    }

    .cart-item-meta {
      font-size: 0.75rem;
      color: var(--text-dim);
      margin-top: 4px;
    }

    .cart-item-footer {
      display: flex;
      align-items: center;
      justify-content: space-between;
      margin-top: 8px;
    }

    .cart-item-price {
      font-weight: 700;
      color: var(--gold-primary);
      font-size: 0.95rem;
    }

    .cart-remove-btn {
      color: var(--text-dim);
      cursor: pointer;
      transition: color 0.2s ease;
      padding: 4px;
    }

    .cart-remove-btn:hover {
      color: #ef4444;
    }

    .cart-summary {
      padding: 24px;
      border-top: 1px solid var(--border-color);
      background: var(--bg-surface);
      display: flex;
      flex-direction: column;
      gap: 12px;
    }

    .summary-row {
      display: flex;
      justify-content: space-between;
      font-size: 0.88rem;
      color: var(--text-secondary);
    }

    .summary-row.total {
      font-size: 1.15rem;
      font-weight: 700;
      color: var(--text-main);
      padding-top: 8px;
      border-top: 1px solid var(--border-color);
    }

    .cart-empty-state {
      text-align: center;
      padding: 60px 24px;
      display: flex;
      flex-direction: column;
      align-items: center;
      gap: 12px;
      color: var(--text-dim);
    }

    /* AUTH MODAL & CHECKOUT FORMS */
    .auth-modal-box {
      max-width: 520px;
      padding: 32px;
    }

    .auth-tabs {
      display: flex;
      border-bottom: 1px solid var(--border-color);
      margin-bottom: 24px;
    }

    .auth-tab {
      flex: 1;
      text-align: center;
      padding: 12px;
      font-size: 0.9rem;
      font-weight: 600;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      cursor: pointer;
      color: var(--text-dim);
      border-bottom: 2px solid transparent;
      transition: var(--transition-smooth);
    }

    .auth-tab.active {
      color: var(--gold-primary);
      border-color: var(--gold-primary);
    }

    .form-group {
      margin-bottom: 14px;
      display: flex;
      flex-direction: column;
      gap: 6px;
    }

    .form-label {
      font-size: 0.78rem;
      font-weight: 600;
      letter-spacing: 0.04em;
      text-transform: uppercase;
      color: var(--text-secondary);
    }

    .form-input, .form-textarea {
      background: var(--bg-input);
      border: 1px solid var(--border-color);
      border-radius: var(--radius-sm);
      padding: 10px 14px;
      font-size: 0.88rem;
      color: var(--text-main);
      transition: var(--transition-smooth);
      width: 100%;
    }

    .form-input:focus, .form-textarea:focus {
      border-color: var(--gold-primary);
      box-shadow: 0 0 0 2px var(--border-color-focus);
    }

    .form-row {
      display: grid;
      grid-template-columns: 1fr 1fr;
      gap: 12px;
    }

    /* CHECKOUT & ORDER CONFIRMATION */
    .checkout-modal-box {
      max-width: 680px;
      padding: 32px;
    }

    .cod-badge-box {
      background: rgba(212, 175, 55, 0.08);
      border: 1px solid rgba(212, 175, 55, 0.3);
      padding: 14px;
      border-radius: var(--radius-sm);
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 16px 0;
    }

    /* ORDER TRACKING TIMELINE */
    .tracking-modal-box {
      max-width: 680px;
      padding: 32px;
    }

    .timeline-wrap {
      margin: 24px 0;
      display: flex;
      flex-direction: column;
      gap: 18px;
      position: relative;
    }

    .timeline-item {
      display: flex;
      gap: 16px;
      position: relative;
    }

    .timeline-node {
      width: 28px;
      height: 28px;
      border-radius: 50%;
      background: var(--bg-surface-elevated);
      border: 2px solid var(--border-color);
      display: flex;
      align-items: center;
      justify-content: center;
      font-size: 0.75rem;
      font-weight: 700;
      color: var(--text-dim);
      flex-shrink: 0;
      z-index: 2;
    }

    .timeline-item.completed .timeline-node {
      background: var(--gold-primary);
      border-color: var(--gold-primary);
      color: #000000;
    }

    .timeline-item.error .timeline-node {
      background: #ef4444;
      border-color: #ef4444;
      color: #ffffff;
    }

    .timeline-content {
      flex: 1;
    }

    .timeline-title {
      font-weight: 600;
      font-size: 0.9rem;
      color: var(--text-main);
    }

    .timeline-desc {
      font-size: 0.78rem;
      color: var(--text-dim);
      margin-top: 2px;
    }

    /* FOOTER */
    .site-footer {
      background: #000000;
      color: #ffffff;
      padding: 60px 24px 30px;
      border-top: 1px solid rgba(212, 175, 55, 0.2);
    }

    .footer-container {
      max-width: 1360px;
      margin: 0 auto;
      display: grid;
      grid-template-columns: 2fr 1fr 1fr 1.5fr;
      gap: 40px;
      margin-bottom: 48px;
    }

    .footer-logo {
      height: 44px;
      object-fit: contain;
      margin-bottom: 16px;
    }

    .footer-desc {
      font-size: 0.85rem;
      color: #a1a1aa;
      line-height: 1.6;
      max-width: 320px;
    }

    .footer-heading {
      font-size: 0.85rem;
      font-weight: 600;
      letter-spacing: 0.1em;
      text-transform: uppercase;
      color: var(--gold-primary);
      margin-bottom: 16px;
    }

    .footer-links {
      list-style: none;
      display: flex;
      flex-direction: column;
      gap: 10px;
    }

    .footer-link {
      font-size: 0.85rem;
      color: #a1a1aa;
      transition: color 0.2s ease;
    }

    .footer-link:hover {
      color: #ffffff;
    }

    .footer-bottom {
      max-width: 1360px;
      margin: 0 auto;
      padding-top: 24px;
      border-top: 1px solid rgba(255, 255, 255, 0.1);
      display: flex;
      justify-content: space-between;
      align-items: center;
      font-size: 0.78rem;
      color: #71717a;
      flex-wrap: wrap;
      gap: 16px;
    }

    /* TOAST NOTIFICATION */
    .toast-container {
      position: fixed;
      bottom: 24px;
      right: 24px;
      z-index: 200;
      display: flex;
      flex-direction: column;
      gap: 10px;
      pointer-events: none;
    }

    .toast-msg {
      background: #14141a;
      color: #ffffff;
      border: 1px solid var(--gold-primary);
      padding: 12px 20px;
      border-radius: var(--radius-sm);
      font-size: 0.85rem;
      box-shadow: var(--shadow-lg);
      display: flex;
      align-items: center;
      gap: 10px;
      pointer-events: auto;
      animation: slideInToast 0.3s ease;
    }

    @keyframes slideInToast {
      from { transform: translateX(100%); opacity: 0; }
      to { transform: translateX(0); opacity: 1; }
    }

    /* RESPONSIVE DESIGN BREAKPOINTS */
    @media (max-width: 1024px) {
      .footer-container {
        grid-template-columns: 1fr 1fr;
      }
      .product-detail-layout {
        grid-template-columns: 1fr;
      }
    }

    @media (max-width: 768px) {
      .nav-links {
        display: none;
      }
      .mobile-menu-btn {
        display: flex;
      }
      .hero-title {
        font-size: 2.2rem;
      }
      .products-grid {
        grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
        gap: 16px;
      }
      .footer-container {
        grid-template-columns: 1fr;
        gap: 32px;
      }
      .product-detail-layout {
        padding: 20px;
      }
    }

    @media (max-width: 480px) {
      .products-grid {
        grid-template-columns: 1fr;
      }
      .form-row {
        grid-template-columns: 1fr;
      }
    }
  </style>
</head>
<body>

  <!-- 1. TOP ANNOUNCEMENT BAR -->
  <aside class="announcement-bar" aria-label="Promotions">
    <div class="announcement-controls">
      <div class="currency-selector-top" onclick="openCurrencyModal()" title="Select Currency">
        <span id="topCurrencyFlag">🇦🇪</span>
        <span id="topCurrencyCode" style="font-weight: 700;">AED</span>
        <i data-lucide="chevron-down" style="width: 12px; height: 12px;"></i>
      </div>
    </div>
    <div class="announcement-content">
      <i data-lucide="sparkles" style="width: 14px; height: 14px; color: var(--gold-primary);"></i>
      <span>Complimentary Worldwide Express Shipping • <strong>Cash On Delivery Available</strong></span>
    </div>
    <div class="announcement-controls">
      <button class="theme-toggle-btn" onclick="toggleTheme()" id="themeToggleBtn" title="Switch Theme">
        <i data-lucide="sun" id="themeIconSun" style="width: 13px; height: 13px; display: none;"></i>
        <i data-lucide="moon" id="themeIconMoon" style="width: 13px; height: 13px;"></i>
        <span id="themeLabel">Dark</span>
      </button>
    </div>
  </aside>

  <!-- 2. SITE HEADER & NAVIGATION -->
  <header class="site-header">
    <div class="nav-container">
      
      <!-- Nav Left (Links) -->
      <nav class="nav-left" aria-label="Main navigation">
        <button class="mobile-menu-btn icon-action-btn" onclick="toggleMobileNav()" aria-label="Open menu">
          <i data-lucide="menu"></i>
        </button>
        <ul class="nav-links">
          <li><a href="#" class="nav-link active" onclick="filterByGender('all', event)">Atelier Collection</a></li>
          <li><a href="#" class="nav-link" onclick="filterByGender('men', event)">Men</a></li>
          <li><a href="#" class="nav-link" onclick="filterByGender('women', event)">Women</a></li>
          <li><a href="#" class="nav-link" onclick="openTrackOrderModal(event)">Track Order</a></li>
        </ul>
      </nav>

      <!-- Center Logo (Dynamic: logo-white.png in dark, logo.png in light) -->
      <div class="brand-logo-wrap">
        <a href="/" aria-label="Qalidotae Homepage">
          <img src="/logo-white.png" alt="Qalidotae Atelier" class="brand-logo-img" id="headerLogoImg" />
        </a>
      </div>

      <!-- Nav Right (Search, Account, Cart) -->
      <div class="nav-right">
        <button class="icon-action-btn" onclick="focusSearch()" title="Search Garments">
          <i data-lucide="search"></i>
        </button>

        <button class="icon-action-btn" onclick="handleAccountClick()" id="accountBtn" title="My Account">
          <i data-lucide="user"></i>
        </button>

        <button class="icon-action-btn" onclick="openCartDrawer()" title="Shopping Bag">
          <i data-lucide="shopping-bag"></i>
          <span class="cart-badge" id="cartCountBadge">0</span>
        </button>
      </div>

    </div>
  </header>

  <!-- MOBILE NAVIGATION DRAWER -->
  <div class="cart-drawer-overlay" id="mobileNavOverlay" onclick="toggleMobileNav()">
    <div class="cart-drawer" style="left: 0; right: auto; transform: translateX(-100%);" onclick="event.stopPropagation()">
      <div class="cart-header">
        <div class="brand-logo-wrap">
          <img src="/logo-white.png" alt="Qalidotae" class="brand-logo-img" id="mobileDrawerLogoImg" style="height: 38px;" />
        </div>
        <button class="modal-close-btn" style="position: static;" onclick="toggleMobileNav()">
          <i data-lucide="x"></i>
        </button>
      </div>
      <div class="cart-items-list" style="gap: 20px; padding: 24px;">
        <a href="#" class="nav-link" onclick="filterByGender('all', event); toggleMobileNav();">All Collections</a>
        <a href="#" class="nav-link" onclick="filterByGender('men', event); toggleMobileNav();">Men's Luxury Thobes</a>
        <a href="#" class="nav-link" onclick="filterByGender('women', event); toggleMobileNav();">Women's Abayas & Kaftans</a>
        <a href="#" class="nav-link" onclick="openTrackOrderModal(event); toggleMobileNav();">Track Order Status</a>
        <div style="border-top: 1px solid var(--border-color); padding-top: 16px; margin-top: 10px;">
          <div style="font-size: 0.8rem; color: var(--gold-primary); font-weight: 600; margin-bottom: 10px;">PREFERENCES</div>
          <button class="btn-outline" style="width: 100%; justify-content: center; display: flex; gap: 8px; margin-bottom: 10px;" onclick="openCurrencyModal()">
            <i data-lucide="globe"></i> Change Currency (<span id="mobileCurrencyText">AED</span>)
          </button>
          <button class="btn-outline" style="width: 100%; justify-content: center; display: flex; gap: 8px;" onclick="toggleTheme()">
            <i data-lucide="moon"></i> Toggle Theme
          </button>
        </div>
      </div>
    </div>
  </div>

  <!-- 3. HERO EDITORIAL SECTION -->
  <section class="hero-section">
    <div class="hero-container">
      <span class="hero-subtitle"><i data-lucide="award" style="width: 14px; height: 14px;"></i> Artisanal Arabic Haute Couture</span>
      <h1 class="hero-title">The Pinnacle of <em>Middle Eastern</em> Luxury</h1>
      <p class="hero-description">
        Handcrafted thobes, abayas, and couture silhouettes woven from the rarest Japanese spun silks and Normandy linens. Designed for presence and effortless grace.
      </p>
      <div class="hero-cta-group">
        <button class="btn-gold" onclick="filterByGender('men')">
          <span>Explore Men's Thobes</span>
          <i data-lucide="arrow-right" style="width: 16px; height: 16px;"></i>
        </button>
        <button class="btn-outline" onclick="filterByGender('women')">
          <span>Explore Women's Haute Abayas</span>
        </button>
      </div>
    </div>
  </section>

