    /* =======================================================================
       4. ORDERS CONTROLLER (Collection: ORDERS_DETAILS)
       ======================================================================= */
    async function fetchOrders() {
      try {
        const res = await fetch('/admin/api/orders');
        const data = await res.json();
        if (data.success) {
          state.orders = data.orders || [];
          filterAndRenderOrders();
        }
      } catch (err) {
        showToast('Failed to fetch orders: ' + err.message, 'error');
      }
    }

    function getStatusBadgeClass(status) {
      const map = {
        'order pending': 'badge-pending',
        'order confirmed': 'badge-confirmed',
        'delivery ongoing': 'badge-ongoing',
        'delivery success': 'badge-success',
        'order rejected': 'badge-rejected',
        'order cancelled': 'badge-cancelled'
      };
      return map[status] || 'badge-dim';
    }

    function filterAndRenderOrders() {
      const search = document.getElementById('orderSearchInput')?.value.toLowerCase() || '';
      const statusFilter = document.getElementById('orderStatusFilter')?.value || 'ALL';
      const sort = document.getElementById('orderSortSelect')?.value || state.orderSort;

      let filtered = state.orders.filter(o => {
        const orderNum = (o.orderNumber || o._id).toLowerCase();
        const clientName = (o.userId?.fullName || '').toLowerCase();
        const clientEmail = (o.userId?.email || '').toLowerCase();
        const prodNames = Array.isArray(o.items) && o.items.length > 0
          ? o.items.map(i => (i.productId?.name || '').toLowerCase()).join(' ')
          : (o.productId?.name || '').toLowerCase();

        const matchSearch = orderNum.includes(search) ||
                            clientName.includes(search) ||
                            clientEmail.includes(search) ||
                            prodNames.includes(search);
        const matchStatus = statusFilter === 'ALL' || o.status === statusFilter;
        return matchSearch && matchStatus;
      });

      // Sorting
      filtered.sort((a, b) => {
        if (sort === 'oldest') return new Date(a.createdAt) - new Date(b.createdAt);
        if (sort === 'amount_desc') return b.totalPrice - a.totalPrice;
        if (sort === 'amount_asc') return a.totalPrice - b.totalPrice;
        if (sort === 'client_asc') return (a.userId?.fullName || '').localeCompare(b.userId?.fullName || '');
        return new Date(b.createdAt) - new Date(a.createdAt); // newest
      });

      // Pagination (10 rows per page)
      const totalRows = filtered.length;
      const totalPages = Math.ceil(totalRows / state.pageSize) || 1;
      if (state.orderPage > totalPages) state.orderPage = 1;

      const startIndex = (state.orderPage - 1) * state.pageSize;
      const paginatedItems = filtered.slice(startIndex, startIndex + state.pageSize);

      const tbody = document.getElementById('ordersTableBody');
      if (paginatedItems.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="empty-state">No orders found.</td></tr>`;
      } else {
        tbody.innerHTML = paginatedItems.map(o => {
          const client = o.userId || {};
          const itemsList = Array.isArray(o.items) && o.items.length > 0
            ? o.items
            : (o.productId ? [{ productId: o.productId, selectedSize: (o.selectedSizes || [])[0] || 'M', quantity: o.quantity || 1, price: o.totalPrice }] : []);
          const totalQty = itemsList.reduce((acc, item) => acc + (item.quantity || 1), 0);
          const dateStr = new Date(o.createdAt).toLocaleDateString([], { month: 'short', day: 'numeric', year: 'numeric' });

          const productsSummaryHtml = itemsList.map(item => {
            const p = item.productId || {};
            return `<div style="font-weight: 500; font-size: 0.85rem; line-height: 1.3;">${p.name || 'Atelier Garment'} <span style="font-size: 0.72rem; color: var(--text-dim);">(${item.selectedSize || 'M'}, x${item.quantity})</span></div>`;
          }).join('');

          return `
            <tr>
              <td>
                <strong style="color: var(--gold-primary); font-family: monospace;">${o.orderNumber || o._id.slice(-6)}</strong>
              </td>
              <td>
                <div style="font-weight: 600; color: var(--text-main);">${client.fullName || 'Guest User'}</div>
                <div style="font-size: 0.72rem; color: var(--text-dim);">${client.email || '—'}</div>
              </td>
              <td>
                ${productsSummaryHtml || '<div style="font-weight: 500;">Custom Garment</div>'}
                ${itemsList.length > 1 ? `<span class="badge badge-dim" style="margin-top: 3px; font-size: 0.68rem;">${itemsList.length} distinct items</span>` : ''}
              </td>
              <td>
                <span class="badge badge-dim">${totalQty} ${totalQty === 1 ? 'unit' : 'units'}</span>
              </td>
              <td><strong>AED ${o.totalPrice}</strong></td>
              <td>
                <span class="badge ${getStatusBadgeClass(o.status)}">${o.status}</span>
              </td>
              <td style="font-size: 0.78rem; color: var(--text-dim);">${dateStr}</td>
              <td style="text-align: right;">
                <div class="table-actions" style="justify-content: flex-end;">
                  <button class="icon-btn gold" title="View / Update Order" onclick="openOrderModal('${o._id}')">
                    <i data-lucide="eye"></i>
                  </button>
                  <button class="icon-btn danger" title="Delete Order" onclick="confirmDeleteOrder('${o._id}', '${o.orderNumber || o._id}')">
                    <i data-lucide="trash-2"></i>
                  </button>
                </div>
              </td>
            </tr>
          `;
        }).join('');
      }

      renderPagination('ordersPagination', state.orderPage, totalPages, totalRows, 'setOrderPage');
      lucide.createIcons();
    }

    function setOrderPage(p) {
      state.orderPage = p;
      filterAndRenderOrders();
    }

    function openOrderModal(id) {
      const order = state.orders.find(o => o._id === id);
      if (!order) return;

      const client = order.userId || {};
      const itemsList = Array.isArray(order.items) && order.items.length > 0
        ? order.items
        : (order.productId ? [{ productId: order.productId, selectedSize: (order.selectedSizes || [])[0] || 'M', quantity: order.quantity || 1, price: order.totalPrice }] : []);

      document.getElementById('orderModalId').value = order._id;
      document.getElementById('orderModalTitle').innerText = `Order ${order.orderNumber || order._id}`;
      document.getElementById('orderModalSubtitle').innerText = `Ordered on ${new Date(order.createdAt).toLocaleString()}`;

      // Populate Client Info
      document.getElementById('orderModalClientInfo').innerHTML = `
        <div style="font-weight: 600; color: var(--text-main); font-size: 0.9rem;">${client.fullName || 'Unknown Client'}</div>
        <div><strong>Email:</strong> <a href="mailto:${client.email}" style="color: var(--gold-primary);">${client.email || '—'}</a></div>
        <div><strong>Phone:</strong> ${client.phoneNumber || '—'}</div>
        <div><strong>WhatsApp:</strong> ${client.whatsappNumber || '—'}</div>
        <div style="margin-top: 6px; padding-top: 6px; border-top: 1px dashed var(--border-subtle);">
          <strong>Shipping Destination:</strong><br>
          ${client.housename ? client.housename + ', ' : ''}${client.place ? client.place + ', ' : ''}<br>
          ${client.landmark ? 'Landmark: ' + client.landmark + '<br>' : ''}
          ${client.city || ''} ${client.postalCode ? '— ' + client.postalCode : ''}, ${client.country || 'UAE'}
        </div>
        ${order.shippingNotes ? `<div style="margin-top: 6px; font-size: 0.8rem; color: var(--gold-primary); background: rgba(212,175,55,0.06); padding: 6px 8px; border-radius: 4px;"><strong>Shipping Notes:</strong> ${order.shippingNotes}</div>` : ''}
      `;

      // Populate Items Info
      const itemsHtml = itemsList.map(item => {
        const product = item.productId || {};
        const itemPrice = item.price || product.price || 0;
        return `
          <div style="display: flex; gap: 12px; align-items: center; padding: 8px 0; border-bottom: 1px solid var(--border-subtle);">
            ${product.frontImage ? `<img src="${product.frontImage}" style="width: 48px; height: 58px; object-fit: cover; border-radius: var(--radius-sm); border: 1px solid var(--border-subtle); flex-shrink: 0;">` : ''}
            <div style="flex: 1;">
              <div style="font-weight: 600; color: var(--text-main); font-size: 0.88rem;">${product.name || 'Atelier Garment'}</div>
              <div style="font-size: 0.75rem; color: var(--text-dim);">${product.type || ''} • Size: <strong style="color: var(--gold-primary);">${item.selectedSize || 'M'}</strong> ${item.color ? `• Color: ${item.color}` : ''}</div>
              <div style="font-size: 0.78rem; margin-top: 2px;">Qty: <strong>${item.quantity}</strong> × AED ${itemPrice} = <strong style="color: var(--gold-primary);">AED ${itemPrice * item.quantity}</strong></div>
            </div>
          </div>
        `;
      }).join('');

      document.getElementById('orderModalProductInfo').innerHTML = `
        <div style="max-height: 220px; overflow-y: auto; margin-bottom: 10px;">
          ${itemsHtml}
        </div>
        <div style="font-size: 1rem; color: var(--gold-primary); padding-top: 8px; border-top: 1px solid var(--border-subtle);"><strong>Total Order Value:</strong> AED ${order.totalPrice}</div>
        <div style="font-size: 0.78rem; color: var(--text-dim); margin-top: 4px;">Payment Method: <strong>${order.paymentMode || 'Cash On Delivery'}</strong></div>
      `;

      // Populate Status dropdown & rejection reason
      const statusSelect = document.getElementById('orderStatusSelect');
      statusSelect.value = order.status;
      handleOrderStatusChange(order.status);

      document.getElementById('orderRejectionReason').value = order.rejectionReason || '';

      openModal('orderModal');
    }

    function handleOrderStatusChange(status) {
      const wrap = document.getElementById('orderRejectionWrap');
      if (status === 'order rejected') {
        wrap.style.display = 'block';
      } else {
        wrap.style.display = 'none';
      }
    }

    async function submitOrderStatus() {
      const id = document.getElementById('orderModalId').value;
      const status = document.getElementById('orderStatusSelect').value;
      const rejectionReason = document.getElementById('orderRejectionReason').value.trim();

      if (status === 'order rejected' && !rejectionReason) {
        showToast('Please enter a rejection reason.', 'error');
        return;
      }

      try {
        const res = await fetch(`/admin/api/orders/${id}/status`, {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ status, rejectionReason })
        });
        const result = await res.json();
        if (result.success) {
          showToast('Order status updated.', 'success');
          closeModal('orderModal');
          await fetchOrders();
          fetchOverview();
        } else {
          showToast(result.message || 'Failed to update order status.', 'error');
        }
      } catch (err) {
        showToast('Error: ' + err.message, 'error');
      }
    }

    function confirmDeleteOrder(id, orderNum) {
      showDangerModal({
        title: 'Delete Order Record',
        message: `Are you sure you want to permanently delete order "${orderNum}" from ORDERS_DETAILS?`,
        onConfirm: async () => {
          try {
            const res = await fetch(`/admin/api/orders/${id}`, { method: 'DELETE' });
            const result = await res.json();
            if (result.success) {
              showToast('Order deleted successfully.', 'success');
              await fetchOrders();
              fetchOverview();
            } else {
              showToast(result.message, 'error');
            }
          } catch (err) {
            showToast(err.message, 'error');
          }
        }
      });
    }


    /* =======================================================================
       5. PAYMENT SETUP CONTROLLER (Collection: PAYMENT_SETUP)
       ======================================================================= */
    async function fetchPaymentSetup() {
      try {
        const res = await fetch('/admin/api/payment-setup');
        const data = await res.json();
        if (data.success && data.paymentSetup) {
          state.paymentSetup = data.paymentSetup;
          const p = data.paymentSetup;

          document.getElementById('paymentUpiId').value = p.upiId || '';
          document.getElementById('paymentGpayNumber').value = p.gpayNumber || '';
          document.getElementById('paymentAccountHolder').value = p.accountHolderName || '';
          document.getElementById('paymentBankName').value = p.bankName || '';
          document.getElementById('paymentAccountNumber').value = p.accountNumber || '';
          document.getElementById('paymentIfscCode').value = p.ifscCode || '';
          document.getElementById('paymentInstructions').value = p.instructions || '';
          document.getElementById('paymentIsActive').checked = p.isActive !== undefined ? p.isActive : true;

          if (p.qrCodeImage) {
            state.tempQRImage = p.qrCodeImage;
            document.getElementById('qrCodePreviewImg').src = p.qrCodeImage;
            document.getElementById('qrCodePreviewContainer').style.display = 'block';
          }
        }
      } catch (err) {
        console.error('Fetch payment setup error:', err);
      }
    }

    function handleQRImageUpload(e) {
      const file = e.target.files[0];
      if (!file) return;

      if (file.size > 2 * 1024 * 1024) {
        showToast('QR code image must be less than 2MB.', 'error');
        e.target.value = '';
        return;
      }

      const reader = new FileReader();
      reader.onload = function(evt) {
        state.tempQRImage = evt.target.result;
        document.getElementById('qrCodePreviewImg').src = evt.target.result;
        document.getElementById('qrCodePreviewContainer').style.display = 'block';
      };
      reader.readAsDataURL(file);
    }

    function removeQRImage() {
      state.tempQRImage = '';
      document.getElementById('qrCodeInput').value = '';
      document.getElementById('qrCodePreviewContainer').style.display = 'none';
    }

    async function savePaymentSetup() {
      const payload = {
        qrCodeImage: state.tempQRImage,
        upiId: document.getElementById('paymentUpiId').value.trim(),
        gpayNumber: document.getElementById('paymentGpayNumber').value.trim(),
        accountHolderName: document.getElementById('paymentAccountHolder').value.trim(),
        bankName: document.getElementById('paymentBankName').value.trim(),
        accountNumber: document.getElementById('paymentAccountNumber').value.trim(),
        ifscCode: document.getElementById('paymentIfscCode').value.trim(),
        instructions: document.getElementById('paymentInstructions').value.trim(),
        isActive: document.getElementById('paymentIsActive').checked
      };

      try {
        const res = await fetch('/admin/api/payment-setup', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const result = await res.json();
        if (result.success) {
          showToast('Payment gateway configuration saved in PAYMENT_SETUP.', 'success');
          state.paymentSetup = result.paymentSetup;
        } else {
          showToast(result.message || 'Failed to save payment setup.', 'error');
        }
      } catch (err) {
        showToast('Error: ' + err.message, 'error');
      }
    }


    /* =======================================================================
       6. ADMIN CREDENTIALS CONTROLLER (Collection: ADMIN_CREDINTIALS)
       ======================================================================= */
    function openCredentialsModal() {
      switchSection('credentials');
      loadAdminCredentials();
    }

    async function loadAdminCredentials() {
      try {
        const res = await fetch('/admin/api/credentials');
        const data = await res.json();
        if (data.success && data.admin) {
          document.getElementById('credAdminName').value = data.admin.name || '';
          document.getElementById('credAdminEmail').value = data.admin.email || '';
          document.getElementById('credCurrentPassword').value = '';
          document.getElementById('credNewPassword').value = '';
          document.getElementById('credConfirmPassword').value = '';
        }
      } catch (err) {
        console.error('Fetch credentials error:', err);
      }
    }

    async function saveAdminCredentials() {
      const name = document.getElementById('credAdminName').value.trim();
      const email = document.getElementById('credAdminEmail').value.trim();
      const currentPassword = document.getElementById('credCurrentPassword').value;
      const newPassword = document.getElementById('credNewPassword').value;
      const confirmPassword = document.getElementById('credConfirmPassword').value;

      if (!name || !email) {
        showToast('Name and email are required.', 'error');
        return;
      }

      if (newPassword) {
        if (!currentPassword) {
          showToast('Current password is required to change password.', 'error');
          return;
        }
        if (newPassword.length < 6) {
          showToast('New password must be at least 6 characters.', 'error');
          return;
        }
        if (newPassword !== confirmPassword) {
          showToast('New passwords do not match.', 'error');
          return;
        }
      }

      try {
        const res = await fetch('/admin/api/credentials', {
          method: 'PUT',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ name, email, currentPassword, newPassword })
        });
        const result = await res.json();
        if (result.success) {
          showToast('Admin credentials updated successfully in ADMIN_CREDINTIALS.', 'success');
          document.getElementById('credCurrentPassword').value = '';
          document.getElementById('credNewPassword').value = '';
          document.getElementById('credConfirmPassword').value = '';
        } else {
          showToast(result.message || 'Failed to update credentials.', 'error');
        }
      } catch (err) {
        showToast('Error: ' + err.message, 'error');
      }
    }


    /* =======================================================================
       AUTHENTICATION & SESSION CONTROLLERS (30-day Cookie Session)
       ======================================================================= */
    async function handleLogin() {
      const email = document.getElementById('loginEmail').value.trim();
      const password = document.getElementById('loginPassword').value;
      const btn = document.getElementById('loginBtn');

      if (!email || !password) {
        showToast('Please enter your email and password.', 'error');
        return;
      }

      btn.disabled = true;
      btn.innerHTML = `<span>Authenticating...</span>`;

      try {
        const res = await fetch('/admin/login', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ email, password })
        });
        const data = await res.json();

        if (data.success) {
          showToast('Welcome to Qalidotae Atelier Admin.', 'success');
          setTimeout(() => {
            window.location.reload();
          }, 600);
        } else {
          showToast(data.message || 'Invalid credentials.', 'error');
          btn.disabled = false;
          btn.innerHTML = `<i data-lucide="lock"></i><span>Enter Atelier Portal</span>`;
          lucide.createIcons();
        }
      } catch (err) {
        showToast('Network error during login: ' + err.message, 'error');
        btn.disabled = false;
        btn.innerHTML = `<i data-lucide="lock"></i><span>Enter Atelier Portal</span>`;
        lucide.createIcons();
      }
    }

    async function handleLogout() {
      try {
        await fetch('/admin/logout', { method: 'POST' });
        showToast('Signed out successfully.', 'info');
        setTimeout(() => {
          window.location.reload();
        }, 500);
      } catch (err) {
        window.location.reload();
      }
    }


    /* =======================================================================
       REUSABLE 10-ROW PAGINATION COMPONENT
       ======================================================================= */
    function renderPagination(containerId, currentPage, totalPages, totalItems, onPageFnName) {
      const container = document.getElementById(containerId);
      if (!container) return;

      if (totalItems === 0) {
        container.innerHTML = `<div class="pagination-info">No records to display</div>`;
        return;
      }

      const start = (currentPage - 1) * state.pageSize + 1;
      const end = Math.min(currentPage * state.pageSize, totalItems);

      let buttonsHtml = `
        <button class="page-btn" ${currentPage === 1 ? 'disabled' : ''} onclick="${onPageFnName}(${currentPage - 1})">
          <i data-lucide="chevron-left" style="width: 14px; height: 14px;"></i>
        </button>
      `;

      for (let i = 1; i <= totalPages; i++) {
        if (i === 1 || i === totalPages || (i >= currentPage - 1 && i <= currentPage + 1)) {
          buttonsHtml += `
            <button class="page-btn ${i === currentPage ? 'active' : ''}" onclick="${onPageFnName}(${i})">${i}</button>
          `;
        } else if (i === currentPage - 2 || i === currentPage + 2) {
          buttonsHtml += `<span style="padding: 0 4px; color: var(--text-dim);">...</span>`;
        }
      }

      buttonsHtml += `
        <button class="page-btn" ${currentPage === totalPages ? 'disabled' : ''} onclick="${onPageFnName}(${currentPage + 1})">
          <i data-lucide="chevron-right" style="width: 14px; height: 14px;"></i>
        </button>
      `;

      container.innerHTML = `
        <div class="pagination-info">Showing <strong>${start}–${end}</strong> of <strong>${totalItems}</strong> entries (10 rows/page)</div>
        <div class="pagination-controls">${buttonsHtml}</div>
      `;
    }
  </script>
</body>
</html>