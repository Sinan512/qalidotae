  <!-- 4. DANGER CONFIRMATION MODAL -->
  <div class="modal-backdrop" id="dangerModal">
    <div class="modal-box" style="max-width: 440px;">
      <div class="modal-header" style="border-bottom-color: var(--danger-surface);">
        <h3 class="modal-title" style="color: var(--danger);" id="dangerModalTitle">Confirm Deletion</h3>
        <button class="modal-close" onclick="closeModal('dangerModal')"><i data-lucide="x"></i></button>
      </div>
      <div class="modal-body" style="text-align: center; padding: 28px 24px;">
        <i data-lucide="alert-triangle" style="width: 48px; height: 48px; color: var(--danger); margin-bottom: 12px;"></i>
        <div id="dangerModalMessage" style="font-size: 0.9rem; color: var(--text-main); margin-bottom: 8px;">Are you sure you want to delete this item?</div>
        <div style="font-size: 0.75rem; color: var(--text-dim);">This action is permanent and cannot be undone in MongoDB.</div>
      </div>
      <div class="modal-footer" style="justify-content: center;">
        <button type="button" class="btn btn-secondary" onclick="closeModal('dangerModal')">Cancel</button>
        <button type="button" class="btn btn-danger" id="dangerConfirmBtn">Confirm Delete</button>
      </div>
    </div>
  </div>

  <!-- Toast Notification Container -->
  <div class="toast-container" id="toastContainer"></div>


  <script>
        //    CLIENT-SIDE JAVASCRIPT ENGINE
    // State Store
    const state = {
      theme: localStorage.getItem('qalid_theme') || 'dark',
      currentSection: 'overview',
      products: [],
      users: [],
      orders: [],
      paymentSetup: null,
      
      // Pagination states (10 items per page)
      pageSize: 10,
      productPage: 1,
      userPage: 1,
      orderPage: 1,

      // Filter & Sort states
      productSort: 'newest',
      userSort: 'newest',
      orderSort: 'newest',

      // Temp image buffers for product / payment setup
      tempFrontImage: '',
      tempBackImage: '',
      tempQRImage: ''
    };

    // Initialize on DOM ready
    document.addEventListener('DOMContentLoaded', () => {
      applyTheme(state.theme);
      lucide.createIcons();
      updateClock();
      setInterval(updateClock, 1000);
      
        {{#if isAuthenticated}}
      loadInitialData();
      {{/if}}
    });

    function updateClock() {
      const el = document.getElementById('systemTime');
      if (el) {
        const d = new Date();
        el.innerText = d.toLocaleTimeString([], { hour: '2-digit', minute: '2-digit' });
      }
    }

    /* =======================================================================
       THEME CONTROLLER
       ======================================================================= */
    function applyTheme(theme) {
      state.theme = theme;
      document.documentElement.setAttribute('data-theme', theme);
      localStorage.setItem('qalid_theme', theme);

      const icon = document.getElementById('themeIcon');
      if (icon) {
        icon.setAttribute('data-lucide', theme === 'dark' ? 'sun' : 'moon');
        lucide.createIcons();
      }

      // Update logo images if needed
      const sidebarLogo = document.getElementById('sidebarLogo');
      const loginLogo = document.getElementById('loginBrandLogo');
      const logoSrc = theme === 'dark' ? '/logo-white.png' : '/logo.png';
      if (sidebarLogo) sidebarLogo.src = logoSrc;
      if (loginLogo) loginLogo.src = logoSrc;
    }

    function toggleTheme() {
      applyTheme(state.theme === 'dark' ? 'light' : 'dark');
    }

    /* =======================================================================
       SIDEBAR & SECTION SWITCHING (Single Section View)
       ======================================================================= */
    function switchSection(sectionId) {
      state.currentSection = sectionId;

      // Update nav items
      document.querySelectorAll('.admin-sidebar .nav-item').forEach(item => {
        item.classList.remove('active');
      });
      const targetNav = Array.from(document.querySelectorAll('.admin-sidebar .nav-item'))
        .find(item => item.getAttribute('onclick')?.includes(sectionId));
      if (targetNav) targetNav.classList.add('active');

      // Update view sections (ONLY selected section is shown)
      document.querySelectorAll('.view-section').forEach(sec => {
        sec.classList.remove('active');
      });
      const activeSec = document.getElementById(`section-${sectionId}`);
      if (activeSec) activeSec.classList.add('active');

      // Update header title
      const titles = {
        overview: 'Dashboard Overview',
        products: 'Products Management',
        users: 'Client Profiles & USERSDETALIS',
        orders: 'Orders & Fulfillment',
        payment: 'Payment Gateway Configuration',
        credentials: 'Admin Credentials'
      };
      const titleEl = document.getElementById('currentSectionTitle');
      if (titleEl) titleEl.innerText = titles[sectionId] || 'Atelier Console';

      // Close mobile sidebar if open
      toggleSidebar(false);

      // Re-trigger layout icons
      lucide.createIcons();
    }

    function toggleSidebar(open) {
      const sb = document.getElementById('adminSidebar');
      const bd = document.getElementById('sidebarBackdrop');
      if (open) {
        sb.classList.add('open');
        bd.classList.add('show');
      } else {
        sb.classList.remove('open');
        bd.classList.remove('show');
      }
    }

    function toggleProfileDropdown(e) {
      e.stopPropagation();
      const dd = document.getElementById('profileDropdown');
      dd.classList.toggle('show');
    }

    document.addEventListener('click', () => {
      const dd = document.getElementById('profileDropdown');
      if (dd) dd.classList.remove('show');
    });

    /* =======================================================================
       TOAST NOTIFICATIONS
       ======================================================================= */
    function showToast(message, type = 'info') {
      const container = document.getElementById('toastContainer');
      const toast = document.createElement('div');
      toast.className = `toast ${type}`;

      const iconMap = {
        success: 'check-circle',
        error: 'alert-circle',
        warning: 'alert-triangle',
        info: 'info'
      };

      toast.innerHTML = `
        <i data-lucide="${iconMap[type] || 'info'}" style="width: 18px; height: 18px; flex-shrink: 0;"></i>
        <span>${message}</span>
      `;
      container.appendChild(toast);
      lucide.createIcons();

      setTimeout(() => {
        toast.style.opacity = '0';
        toast.style.transform = 'translateX(20px)';
        toast.style.transition = 'all 0.3s ease';
        setTimeout(() => toast.remove(), 300);
      }, 4000);
    }

    /* =======================================================================
       MODAL CONTROLLERS
       ======================================================================= */
    function openModal(id) {
      const modal = document.getElementById(id);
      if (modal) {
        modal.classList.add('show');
        lucide.createIcons();
      }
    }

    function closeModal(id) {
      const modal = document.getElementById(id);
      if (modal) modal.classList.remove('show');
    }

    function showDangerModal({ title, message, onConfirm }) {
      document.getElementById('dangerModalTitle').innerText = title || 'Confirm Deletion';
      document.getElementById('dangerModalMessage').innerText = message || 'Are you sure you want to proceed?';
      
      const confirmBtn = document.getElementById('dangerConfirmBtn');
      confirmBtn.onclick = async () => {
        closeModal('dangerModal');
        await onConfirm();
      };

      openModal('dangerModal');
    }

    /* =======================================================================
       DATA FETCHER & INITIALIZER
       ======================================================================= */
    async function loadInitialData() {
      try {
        await Promise.all([
          fetchOverview(),
          fetchProducts(),
          fetchUsers(),
          fetchOrders(),
          fetchPaymentSetup()
        ]);
      } catch (err) {
        console.error('Data load error:', err);
      }
    }

    /* =======================================================================
       1. OVERVIEW
       ======================================================================= */
    async function fetchOverview() {
      try {
        const res = await fetch('/admin/api/overview');
        const data = await res.json();
        if (data.success && data.overview) {
          const ov = data.overview;
          document.getElementById('kpiRevenue').innerText = `AED ${(ov.totalRevenue || 0).toLocaleString()}`;
          document.getElementById('kpiOrders').innerText = ov.totalOrders || 0;
          document.getElementById('kpiPendingOrders').innerText = ov.pendingOrders || 0;
          document.getElementById('kpiProducts').innerText = ov.activeProducts || 0;
          document.getElementById('kpiArchivedProducts').innerText = ov.archivedProducts || 0;
          document.getElementById('kpiUsers').innerText = ov.totalUsers || 0;

          // Badges in sidebar
          document.getElementById('sidebarProductCount').innerText = ov.totalProducts || 0;
          document.getElementById('sidebarUserCount').innerText = ov.totalUsers || 0;
          document.getElementById('sidebarOrderCount').innerText = ov.totalOrders || 0;

          // Render Recent Orders in Overview
          const recentTable = document.getElementById('overviewRecentOrdersTable');
          if (ov.recentOrders && ov.recentOrders.length > 0) {
            recentTable.innerHTML = ov.recentOrders.map(o => `
              <tr>
                <td><strong style="color: var(--gold-primary); font-family: monospace;">${o.orderNumber || o._id.slice(-6)}</strong></td>
                <td>${o.userId ? o.userId.fullName : 'Guest'}</td>
                <td>AED ${o.totalPrice}</td>
                <td><span class="badge ${getStatusBadgeClass(o.status)}">${o.status}</span></td>
              </tr>
            `).join('');
          } else {
            recentTable.innerHTML = `<tr><td colspan="4" class="empty-state">No orders placed yet.</td></tr>`;
          }

          // Render Low Stock in Overview
          const stockTable = document.getElementById('overviewStockAlertsTable');
          if (ov.lowStockProducts && ov.lowStockProducts.length > 0) {
            stockTable.innerHTML = ov.lowStockProducts.map(p => `
              <tr>
                <td><strong>${p.name}</strong></td>
                <td>${p.type}</td>
                <td>AED ${p.price}</td>
                <td><span class="badge badge-danger">${p.totalStock} left</span></td>
              </tr>
            `).join('');
          } else {
            stockTable.innerHTML = `<tr><td colspan="4" class="empty-state">All active products have healthy stock levels.</td></tr>`;
          }
        }
      } catch (err) {
        console.error('Fetch overview error:', err);
      }
    }

    /* =======================================================================
       2. PRODUCTS CONTROLLER (Collection: PRODUCTS)
       ======================================================================= */
    async function fetchProducts() {
      try {
        const res = await fetch('/admin/api/products');
        const data = await res.json();
        if (data.success) {
          state.products = data.products || [];
          filterAndRenderProducts();
        }
      } catch (err) {
        showToast('Failed to fetch products: ' + err.message, 'error');
      }
    }

    function filterAndRenderProducts() {
      const search = document.getElementById('productSearchInput')?.value.toLowerCase() || '';
      const genderFilter = document.getElementById('productGenderFilter')?.value || 'ALL';
      const archiveFilter = document.getElementById('productArchiveFilter')?.value || 'ALL';
      const sort = document.getElementById('productSortSelect')?.value || state.productSort;

      let filtered = state.products.filter(p => {
        const matchSearch = p.name.toLowerCase().includes(search) ||
                            p.type.toLowerCase().includes(search) ||
                            p._id.toLowerCase().includes(search);
        const matchGender = genderFilter === 'ALL' || p.gender === genderFilter;
        const matchArchive = archiveFilter === 'ALL' ||
                             (archiveFilter === 'active' && !p.archive) ||
                             (archiveFilter === 'archived' && p.archive);
        return matchSearch && matchGender && matchArchive;
      });

      // Sorting
      filtered.sort((a, b) => {
        if (sort === 'name_asc') return a.name.localeCompare(b.name);
        if (sort === 'name_desc') return b.name.localeCompare(a.name);
        if (sort === 'price_asc') return a.price - b.price;
        if (sort === 'price_desc') return b.price - a.price;
        if (sort === 'stock_asc') return a.totalStock - b.totalStock;
        if (sort === 'stock_desc') return b.totalStock - a.totalStock;
        return new Date(b.createdAt) - new Date(a.createdAt); // newest
      });

      // Pagination (10 rows per page)
      const totalRows = filtered.length;
      const totalPages = Math.ceil(totalRows / state.pageSize) || 1;
      if (state.productPage > totalPages) state.productPage = 1;

      const startIndex = (state.productPage - 1) * state.pageSize;
      const paginatedItems = filtered.slice(startIndex, startIndex + state.pageSize);

      const tbody = document.getElementById('productsTableBody');
      if (paginatedItems.length === 0) {
        tbody.innerHTML = `<tr><td colspan="9" class="empty-state">No products found matching criteria.</td></tr>`;
      } else {
        tbody.innerHTML = paginatedItems.map(p => {
          const frontImg = p.frontImage || '/logo-white.png';
          const backImg = p.backImage || frontImg;
          return `
            <tr>
              <td>
                <div class="thumb-group">
                  <img src="${frontImg}" alt="Front" class="table-thumb" title="Front Image">
                  ${p.backImage ? `<img src="${backImg}" alt="Back" class="table-thumb" title="Back Image">` : ''}
                </div>
              </td>
              <td>
                <div style="font-weight: 600; color: var(--text-main);">${p.name}</div>
                <div style="font-size: 0.72rem; color: var(--text-dim);">${p.type}</div>
              </td>
              <td><span style="text-transform: capitalize;">${p.gender || 'men'}</span></td>
              <td><strong>AED ${p.price}</strong></td>
              <td>
                <span class="badge ${p.totalStock <= 5 ? 'badge-danger' : 'badge-gold'}">${p.totalStock} units</span>
              </td>
              <td>
                <div style="font-size: 0.72rem; color: var(--text-muted); max-width: 140px;">${(p.availableSizes || []).join(', ')}</div>
              </td>
              <td>
                <span class="badge ${p.isAvailable ? 'badge-success' : 'badge-danger'}">
                  ${p.isAvailable ? 'In Stock' : 'Out of Stock'}
                </span>
              </td>
              <td>
                <span class="badge ${p.archive ? 'badge-dim' : 'badge-gold'}">
                  ${p.archive ? 'Archived' : 'Active'}
                </span>
              </td>
              <td style="text-align: right;">
                <div class="table-actions" style="justify-content: flex-end;">
                  <button class="icon-btn gold" title="Edit Product" onclick="openProductModal('edit', '${p._id}')">
                    <i data-lucide="edit-2"></i>
                  </button>
                  <button class="icon-btn" title="${p.archive ? 'Unarchive' : 'Archive'}" onclick="toggleProductArchive('${p._id}', ${!p.archive})">
                    <i data-lucide="${p.archive ? 'rotate-ccw' : 'archive'}"></i>
                  </button>
                  <button class="icon-btn danger" title="Delete Product" onclick="confirmDeleteProduct('${p._id}', '${p.name.replace(/'/g, "\\'")}')">
                    <i data-lucide="trash-2"></i>
                  </button>
                </div>
              </td>
            </tr>
          `;
        }).join('');
      }

      renderPagination('productsPagination', state.productPage, totalPages, totalRows, 'setProductPage');
      lucide.createIcons();
    }

    function setProductSort(field) {
      if (field === 'name') {
        state.productSort = state.productSort === 'name_asc' ? 'name_desc' : 'name_asc';
      } else if (field === 'price') {
        state.productSort = state.productSort === 'price_asc' ? 'price_desc' : 'price_asc';
      } else if (field === 'stock') {
        state.productSort = state.productSort === 'stock_asc' ? 'stock_desc' : 'stock_asc';
      }
      document.getElementById('productSortSelect').value = state.productSort;
      filterAndRenderProducts();
    }

    function setProductPage(p) {
      state.productPage = p;
      filterAndRenderProducts();
    }

    function openProductModal(mode, id = null) {
      const title = document.getElementById('productModalTitle');
      const form = document.getElementById('productForm');
      form.reset();

      state.tempFrontImage = '';
      state.tempBackImage = '';
      document.getElementById('prodFrontPreviewWrap').style.display = 'none';
      document.getElementById('prodBackPreviewWrap').style.display = 'none';

      if (mode === 'edit' && id) {
        const prod = state.products.find(p => p._id === id);
        if (!prod) return;

        title.innerText = 'Edit Product';
        document.getElementById('prodFormId').value = prod._id;
        document.getElementById('prodName').value = prod.name;
        document.getElementById('prodPrice').value = prod.price;
        document.getElementById('prodType').value = prod.type;
        document.getElementById('prodGender').value = prod.gender || 'men';
        document.getElementById('prodStock').value = prod.totalStock || 0;
        document.getElementById('prodColours').value = (prod.availableColours || []).join(', ');
        document.getElementById('prodIsAvailable').checked = prod.isAvailable;
        document.getElementById('prodArchive').checked = prod.archive;
        document.getElementById('prodDescription').value = prod.description || '';

        // Sizes
        const sizes = prod.availableSizes || [];
        const isAll = sizes.length === 6 && ['XS','S','M','L','XL','XXL'].every(s => sizes.includes(s));
        document.getElementById('size_ALL').checked = isAll;
        document.querySelectorAll('.size-opt').forEach(cb => {
          cb.checked = sizes.includes(cb.value);
        });

        // Images
        if (prod.frontImage) {
          state.tempFrontImage = prod.frontImage;
          document.getElementById('prodFrontPreview').src = prod.frontImage;
          document.getElementById('prodFrontPreviewWrap').style.display = 'block';
        }
        if (prod.backImage) {
          state.tempBackImage = prod.backImage;
          document.getElementById('prodBackPreview').src = prod.backImage;
          document.getElementById('prodBackPreviewWrap').style.display = 'block';
        }
      } else {
        title.innerText = 'Add New Product';
        document.getElementById('prodFormId').value = '';
        document.getElementById('size_ALL').checked = true;
        document.querySelectorAll('.size-opt').forEach(cb => cb.checked = true);
      }

      openModal('productModal');
    }

    function handleAllSizesToggle(el) {
      document.querySelectorAll('.size-opt').forEach(cb => cb.checked = el.checked);
    }

    function handleProductImageUpload(e, type) {
      const file = e.target.files[0];
      if (!file) return;

      if (file.size > 2 * 1024 * 1024) {
        showToast('Image file size must be less than 2MB.', 'error');
        e.target.value = '';
        return;
      }

      const reader = new FileReader();
      reader.onload = function(evt) {
        const base64 = evt.target.result;
        if (type === 'front') {
          state.tempFrontImage = base64;
          document.getElementById('prodFrontPreview').src = base64;
          document.getElementById('prodFrontPreviewWrap').style.display = 'block';
        } else {
          state.tempBackImage = base64;
          document.getElementById('prodBackPreview').src = base64;
          document.getElementById('prodBackPreviewWrap').style.display = 'block';
        }
      };
      reader.readAsDataURL(file);
    }

    function removeProductImage(type) {
      if (type === 'front') {
        state.tempFrontImage = '';
        document.getElementById('prodFrontInput').value = '';
        document.getElementById('prodFrontPreviewWrap').style.display = 'none';
      } else {
        state.tempBackImage = '';
        document.getElementById('prodBackInput').value = '';
        document.getElementById('prodBackPreviewWrap').style.display = 'none';
      }
    }

    async function submitProductForm() {
      const id = document.getElementById('prodFormId').value;
      const name = document.getElementById('prodName').value.trim();
      const price = parseFloat(document.getElementById('prodPrice').value);
      const type = document.getElementById('prodType').value.trim();
      const gender = document.getElementById('prodGender').value;
      const totalStock = parseInt(document.getElementById('prodStock').value) || 0;
      const colours = document.getElementById('prodColours').value;
      const isAvailable = document.getElementById('prodIsAvailable').checked;
      const archive = document.getElementById('prodArchive').checked;
      const description = document.getElementById('prodDescription').value.trim();

      if (!name || isNaN(price) || !type) {
        showToast('Please fill in product name, price, and type.', 'error');
        return;
      }

      // Collect sizes
      const allSelected = document.getElementById('size_ALL').checked;
      const sizes = [];
      if (allSelected) {
        sizes.push('XS', 'S', 'M', 'L', 'XL', 'XXL');
      } else {
        document.querySelectorAll('.size-opt:checked').forEach(cb => sizes.push(cb.value));
      }

      const payload = {
        name,
        price,
        type,
        gender,
        totalStock,
        isAvailable,
        archive,
        description,
        availableSizes: sizes.length > 0 ? sizes : ['XS', 'S', 'M', 'L', 'XL', 'XXL'],
        availableColours: colours ? colours.split(',').map(c => c.trim()).filter(Boolean) : [],
        frontImage: state.tempFrontImage,
        backImage: state.tempBackImage
      };

      try {
        const url = id ? `/admin/api/products/${id}` : '/admin/api/products';
        const method = id ? 'PUT' : 'POST';

        const res = await fetch(url, {
          method,
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });

        const result = await res.json();
        if (result.success) {
          showToast(result.message || 'Product saved successfully.', 'success');
          closeModal('productModal');
          await fetchProducts();
          fetchOverview();
        } else {
          showToast(result.message || 'Failed to save product.', 'error');
        }
      } catch (err) {
        showToast('Error saving product: ' + err.message, 'error');
      }
    }

    async function toggleProductArchive(id, archive) {
      try {
        const res = await fetch(`/admin/api/products/${id}/archive`, {
          method: 'PATCH',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ archive })
        });
        const result = await res.json();
        if (result.success) {
          showToast(result.message, 'success');
          await fetchProducts();
          fetchOverview();
        }
      } catch (err) {
        showToast(err.message, 'error');
      }
    }

    function confirmDeleteProduct(id, name) {
      showDangerModal({
        title: 'Delete Product',
        message: `Are you sure you want to permanently delete "${name}"?`,
        onConfirm: async () => {
          try {
            const res = await fetch(`/admin/api/products/${id}`, { method: 'DELETE' });
            const result = await res.json();
            if (result.success) {
              showToast('Product deleted successfully.', 'success');
              await fetchProducts();
              fetchOverview();
            } else {
              showToast(result.message, 'error');
            }
          } catch (err) {
            showToast(err.message, 'error');
          }
        }
      });
    }


    /* =======================================================================
       3. USERS CONTROLLER (Collection: USERSDETALIS)
       ======================================================================= */
    async function fetchUsers() {
      try {
        const res = await fetch('/admin/api/users');
        const data = await res.json();
        if (data.success) {
          state.users = data.users || [];
          filterAndRenderUsers();
        }
      } catch (err) {
        showToast('Failed to fetch users: ' + err.message, 'error');
      }
    }

    function filterAndRenderUsers() {
      const search = document.getElementById('userSearchInput')?.value.toLowerCase() || '';
      const genderFilter = document.getElementById('userGenderFilter')?.value || 'ALL';
      const sort = document.getElementById('userSortSelect')?.value || state.userSort;

      let filtered = state.users.filter(u => {
        const matchSearch = (u.fullName || '').toLowerCase().includes(search) ||
                            (u.email || '').toLowerCase().includes(search) ||
                            (u.phoneNumber || '').toLowerCase().includes(search) ||
                            (u.city || '').toLowerCase().includes(search) ||
                            (u.country || '').toLowerCase().includes(search);
        const matchGender = genderFilter === 'ALL' || u.gender === genderFilter;
        return matchSearch && matchGender;
      });

      // Sorting
      filtered.sort((a, b) => {
        if (sort === 'name_asc') return (a.fullName || '').localeCompare(b.fullName || '');
        if (sort === 'name_desc') return (b.fullName || '').localeCompare(a.fullName || '');
        if (sort === 'city_asc') return (a.city || '').localeCompare(b.city || '');
        return new Date(b.createdAt) - new Date(a.createdAt); // newest
      });

      // Pagination (10 rows per page)
      const totalRows = filtered.length;
      const totalPages = Math.ceil(totalRows / state.pageSize) || 1;
      if (state.userPage > totalPages) state.userPage = 1;

      const startIndex = (state.userPage - 1) * state.pageSize;
      const paginatedItems = filtered.slice(startIndex, startIndex + state.pageSize);

      const tbody = document.getElementById('usersTableBody');
      if (paginatedItems.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="empty-state">No client profiles found.</td></tr>`;
      } else {
        tbody.innerHTML = paginatedItems.map(u => `
          <tr>
            <td>
              <div class="profile-avatar" style="width: 34px; height: 34px;">${(u.fullName || 'U')[0]}</div>
            </td>
            <td>
              <div style="font-weight: 600; color: var(--text-main);">${u.fullName}</div>
              <div style="font-size: 0.72rem; color: var(--text-dim);">${u.housename || ''} ${u.place || ''}</div>
            </td>
            <td><a href="mailto:${u.email}" style="color: var(--gold-primary);">${u.email}</a></td>
            <td>
              <!-- Password view with Eye Toggle -->
              <div style="display: flex; align-items: center; gap: 8px;">
                <span id="pwd_${u._id}" style="font-family: monospace; font-size: 0.8rem; background: var(--bg-input); padding: 2px 6px; border-radius: 4px;">••••••••</span>
                <button type="button" class="icon-btn" style="width: 26px; height: 26px;" onclick="togglePasswordVisibility('${u._id}', '${u.password.replace(/'/g, "\\'")}')">
                  <i data-lucide="eye" style="width: 14px; height: 14px;"></i>
                </button>
              </div>
            </td>
            <td><span class="badge ${u.gender === 'female' ? 'badge-ongoing' : 'badge-confirmed'}">${u.gender || 'male'}</span></td>
            <td>
              <div style="font-size: 0.78rem;">${u.phoneNumber || '—'}</div>
              ${u.whatsappNumber ? `<div style="font-size: 0.72rem; color: #25d366;">WA: ${u.whatsappNumber}</div>` : ''}
            </td>
            <td>${u.city || ''}, ${u.country || ''}</td>
            <td style="text-align: right;">
              <div class="table-actions" style="justify-content: flex-end;">
                <button class="icon-btn gold" title="View / Edit Profile" onclick="openUserModal('${u._id}')">
                  <i data-lucide="edit-2"></i>
                </button>
                <button class="icon-btn danger" title="Delete Client" onclick="confirmDeleteUser('${u._id}', '${u.fullName.replace(/'/g, "\\'")}')">
                  <i data-lucide="trash-2"></i>
                </button>
              </div>
            </td>
          </tr>
        `).join('');
      }

      renderPagination('usersPagination', state.userPage, totalPages, totalRows, 'setUserPage');
      lucide.createIcons();
    }

    function togglePasswordVisibility(id, pwd) {
      const el = document.getElementById(`pwd_${id}`);
      if (el) {
        if (el.innerText === '••••••••') {
          el.innerText = pwd;
          el.style.color = 'var(--gold-primary)';
        } else {
          el.innerText = '••••••••';
          el.style.color = 'inherit';
        }
      }
    }

    function setUserSort(field) {
      if (field === 'name') {
        state.userSort = state.userSort === 'name_asc' ? 'name_desc' : 'name_asc';
