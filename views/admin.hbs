                <i data-lucide="image" style="width: 24px; height: 24px; color: var(--gold-primary);"></i>
                <div style="font-size: 0.78rem; margin-top: 4px;">Upload Back Image</div>
                <input type="file" id="prodBackInput" accept="image/*" style="display: none;" onchange="handleProductImageUpload(event, 'back')">
              </div>
              <div id="prodBackPreviewWrap" class="preview-img-container" style="display: none;">
                <img id="prodBackPreview" src="" alt="Back Image Preview" class="preview-img">
