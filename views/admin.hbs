<!DOCTYPE html>
<html lang="en" data-theme="dark">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{title}}</title>
  <link rel="icon" href="/logo-white.png">

  <!-- Google Fonts: Cormorant Garamond & Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400&family=Inter:wght@300;400;500;600;700&display=swap" rel="stylesheet">
  <!-- Lucide Icons -->
  <script src="https://unpkg.com/lucide@latest"></script>
  <link rel="stylesheet" href="stylesheets/admin.css">
</head>
<body>

  {{#if isAuthenticated}}
  <!-- =======================================================================
       AUTHENTICATED ADMIN APP
       ======================================================================= -->
  <div class="admin-app">
    <!-- Sidebar Backdrop on mobile -->
    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar(false)"></div>

    <!-- Sidebar -->
    <aside class="admin-sidebar" id="adminSidebar">
      <div class="sidebar-header">
        <img src="/logo-white.png" alt="Qalidotae Logo" class="sidebar-logo" id="sidebarLogo">
        <span class="sidebar-brand">Qalidotae</span>
      </div>

      <nav class="sidebar-nav">
        <div class="nav-category">Atelier Console</div>
        <div class="nav-item active" onclick="switchSection('overview')">
          <i data-lucide="layout-dashboard"></i>
          <span>Overview</span>
        </div>
        <div class="nav-item" onclick="switchSection('products')">
          <i data-lucide="package"></i>
          <span>Products</span>
          <span class="nav-badge" id="sidebarProductCount">0</span>
        </div>
        <div class="nav-item" onclick="switchSection('users')">
          <i data-lucide="users"></i>
          <span>Users</span>
          <span class="nav-badge" id="sidebarUserCount">0</span>
        </div>
        <div class="nav-item" onclick="switchSection('orders')">
          <i data-lucide="shopping-bag"></i>
          <span>Orders</span>
          <span class="nav-badge" id="sidebarOrderCount">0</span>
        </div>

        <div class="nav-category">Configuration</div>
        <div class="nav-item" onclick="switchSection('payment')">
          <i data-lucide="credit-card"></i>
          <span>Payment Setup</span>
        </div>
        <div class="nav-item" onclick="switchSection('credentials')">
          <i data-lucide="shield-check"></i>
          <span>Admin Account</span>
        </div>
      </nav>

      <div class="sidebar-footer">
        <span>v1.0.0 — Luxury Atelier</span>
        <span id="systemTime"></span>
      </div>
    </aside>

    <!-- Main Content Area -->
    <div class="admin-main">
      <!-- Header -->
      <header class="admin-header">
        <div class="header-left">
          <button class="menu-toggle-btn" onclick="toggleSidebar(true)" aria-label="Toggle Menu">
            <i data-lucide="menu"></i>
          </button>
          <h1 class="header-title" id="currentSectionTitle">Dashboard Overview</h1>
        </div>

        <div class="header-right">
          <!-- Theme Toggle -->
          <button class="theme-toggle-btn" onclick="toggleTheme()" title="Toggle Dark/Light Mode">
            <i data-lucide="sun" id="themeIcon"></i>
          </button>

          <!-- Profile Dropdown (Edit Credentials & Logout) -->
          <div class="profile-dropdown-wrap">
            <button class="profile-btn" onclick="toggleProfileDropdown(event)">
              <div class="profile-avatar">{{admin.name.[0]}}</div>
              <div class="profile-info">
                <div class="profile-name">{{admin.name}}</div>
                <div class="profile-role">{{admin.role}}</div>
              </div>
              <i data-lucide="chevron-down" style="width: 14px; height: 14px; color: var(--text-dim);"></i>
            </button>

            <div class="dropdown-menu" id="profileDropdown">
              <div style="padding: 8px 12px; font-size: 0.75rem; color: var(--text-dim); border-bottom: 1px solid var(--border-subtle);">
                Signed in as<br><strong style="color: var(--text-main);">{{admin.email}}</strong>
              </div>
              <button class="dropdown-item" onclick="openCredentialsModal()">
                <i data-lucide="key" style="width: 16px; height: 16px;"></i>
                <span>Edit Credentials</span>
              </button>
              <div class="dropdown-divider"></div>
              <button class="dropdown-item danger" onclick="handleLogout()">
                <i data-lucide="log-out" style="width: 16px; height: 16px;"></i>
                <span>Sign Out</span>
              </button>
            </div>
          </div>
        </div>
      </header>

      <!-- Viewport: Only the selected section is displayed -->
      <main class="admin-content">

        <!-- =================================================================
             1. OVERVIEW SECTION
             ================================================================= -->
        <section id="section-overview" class="view-section active">
          <!-- KPI Metrics -->
          <div class="stats-grid">
            <div class="stat-card">
              <div>
                <div class="stat-label">Total Revenue</div>
                <div class="stat-value" id="kpiRevenue">AED 0</div>
                <div class="stat-subtext">Confirmed & Delivered</div>
              </div>
              <div class="stat-icon"><i data-lucide="coins"></i></div>
            </div>

            <div class="stat-card">
              <div>
                <div class="stat-label">Total Orders</div>
                <div class="stat-value" id="kpiOrders">0</div>
                <div class="stat-subtext"><span id="kpiPendingOrders" style="color: var(--warning); font-weight: 600;">0</span> pending review</div>
              </div>
              <div class="stat-icon"><i data-lucide="shopping-bag"></i></div>
            </div>

            <div class="stat-card">
              <div>
                <div class="stat-label">Active Products</div>
                <div class="stat-value" id="kpiProducts">0</div>
                <div class="stat-subtext"><span id="kpiArchivedProducts">0</span> archived</div>
              </div>
              <div class="stat-icon"><i data-lucide="package"></i></div>
            </div>

            <div class="stat-card">
              <div>
                <div class="stat-label">Registered Clients</div>
                <div class="stat-value" id="kpiUsers">0</div>
                <div class="stat-subtext">In USERSDETALIS</div>
              </div>
              <div class="stat-icon"><i data-lucide="users"></i></div>
            </div>
          </div>

          <!-- Quick Overview Tables -->
          <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(400px, 1fr)); gap: 24px;">
            <!-- Recent Orders Card -->
            <div class="card">
              <div class="card-header">
                <div>
                  <h3 class="card-title">Recent Orders</h3>
                  <div class="card-subtitle">Latest client acquisitions</div>
                </div>
                <button class="btn btn-secondary btn-sm" onclick="switchSection('orders')">View All</button>
              </div>
              <div class="card-body" style="padding: 0;">
                <div class="table-container" style="border: none;">
                  <table class="data-table">
                    <thead>
                      <tr>
                        <th>Order #</th>
                        <th>Client</th>
                        <th>Amount</th>
                        <th>Status</th>
                      </tr>
                    </thead>
                    <tbody id="overviewRecentOrdersTable">
                      <tr><td colspan="4" class="empty-state">Loading recent orders...</td></tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>

            <!-- Stock Alerts Card -->
            <div class="card">
              <div class="card-header">
                <div>
                  <h3 class="card-title">Low Stock Alert</h3>
                  <div class="card-subtitle">Items requiring replenishment (≤ 5 units)</div>
                </div>
                <button class="btn btn-secondary btn-sm" onclick="switchSection('products')">Manage Stock</button>
              </div>
              <div class="card-body" style="padding: 0;">
                <div class="table-container" style="border: none;">
                  <table class="data-table">
                    <thead>
                      <tr>
                        <th>Product</th>
                        <th>Category</th>
                        <th>Price</th>
                        <th>Stock</th>
                      </tr>
                    </thead>
                    <tbody id="overviewStockAlertsTable">
                      <tr><td colspan="4" class="empty-state">Loading stock alerts...</td></tr>
                    </tbody>
                  </table>
                </div>
              </div>
            </div>
          </div>
        </section>


        <!-- =================================================================
             2. PRODUCTS SECTION (Collection: PRODUCTS)
             ================================================================= -->
        <section id="section-products" class="view-section">
          <div class="controls-bar">
            <div class="controls-left">
              <div class="search-box">
                <i data-lucide="search" class="search-icon"></i>
                <input type="text" id="productSearchInput" class="form-input" placeholder="Search by name, type, ID..." oninput="filterAndRenderProducts()">
              </div>

              <select id="productGenderFilter" class="filter-select" onchange="filterAndRenderProducts()">
                <option value="ALL">All Categories</option>
                <option value="men">Men's Collection</option>
                <option value="women">Women's Collection</option>
                <option value="unisex">Unisex</option>
              </select>

              <select id="productArchiveFilter" class="filter-select" onchange="filterAndRenderProducts()">
                <option value="ALL">Archive: All</option>
                <option value="active">Active Only</option>
                <option value="archived">Archived Only</option>
              </select>

              <select id="productSortSelect" class="filter-select" onchange="filterAndRenderProducts()">
                <option value="newest">Sort: Newest First</option>
                <option value="name_asc">Name: A → Z</option>
                <option value="name_desc">Name: Z → A</option>
                <option value="price_asc">Price: Low to High</option>
                <option value="price_desc">Price: High to Low</option>
                <option value="stock_asc">Stock: Low to High</option>
                <option value="stock_desc">Stock: High to Low</option>
              </select>
            </div>

            <button class="btn btn-gold" onclick="openProductModal('create')">
              <i data-lucide="plus"></i>
              <span>Add New Product</span>
            </button>
          </div>

          <div class="table-container">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Product</th>
                  <th class="sortable" onclick="setProductSort('name')">Name & Type</th>
                  <th>Gender</th>
                  <th class="sortable" onclick="setProductSort('price')">Price (AED)</th>
                  <th class="sortable" onclick="setProductSort('stock')">Stock</th>
                  <th>Sizes</th>
                  <th>Availability</th>
                  <th>Archive</th>
                  <th style="text-align: right;">Actions</th>
                </tr>
              </thead>
              <tbody id="productsTableBody">
                <tr><td colspan="9" class="empty-state">Loading products...</td></tr>
              </tbody>
            </table>

            <!-- 10 Rows per page pagination -->
            <div class="pagination-footer" id="productsPagination"></div>
          </div>
        </section>


        <!-- =================================================================
             3. USERS SECTION (Collection: USERSDETALIS)
             ================================================================= -->
        <section id="section-users" class="view-section">
          <div class="controls-bar">
            <div class="controls-left">
              <div class="search-box">
                <i data-lucide="search" class="search-icon"></i>
                <input type="text" id="userSearchInput" class="form-input" placeholder="Search full name, email, phone, city..." oninput="filterAndRenderUsers()">
              </div>

              <select id="userGenderFilter" class="filter-select" onchange="filterAndRenderUsers()">
                <option value="ALL">All Genders</option>
                <option value="male">Male</option>
                <option value="female">Female</option>
              </select>

              <select id="userSortSelect" class="filter-select" onchange="filterAndRenderUsers()">
                <option value="newest">Sort: Registered (Newest)</option>
                <option value="name_asc">Name: A → Z</option>
                <option value="name_desc">Name: Z → A</option>
                <option value="city_asc">City: A → Z</option>
              </select>
            </div>

            <div style="font-size: 0.8rem; color: var(--text-dim); display: flex; align-items: center; gap: 6px;">
              <i data-lucide="info" style="width: 14px; height: 14px;"></i>
              <span>User passwords are view-only for administration</span>
            </div>
          </div>

          <div class="table-container">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Client</th>
                  <th class="sortable" onclick="setUserSort('name')">Full Name</th>
                  <th>Email</th>
                  <th>Password (View)</th>
                  <th>Gender</th>
                  <th>Phone & WhatsApp</th>
                  <th>Location</th>
                  <th style="text-align: right;">Actions</th>
                </tr>
              </thead>
              <tbody id="usersTableBody">
                <tr><td colspan="8" class="empty-state">Loading users...</td></tr>
              </tbody>
            </table>

            <!-- 10 Rows per page pagination -->
            <div class="pagination-footer" id="usersPagination"></div>
          </div>
        </section>


        <!-- =================================================================
             4. ORDERS SECTION (Collection: ORDERS_DETAILS)
             ================================================================= -->
        <section id="section-orders" class="view-section">
          <div class="controls-bar">
            <div class="controls-left">
              <div class="search-box">
                <i data-lucide="search" class="search-icon"></i>
                <input type="text" id="orderSearchInput" class="form-input" placeholder="Search order ID, client name, email..." oninput="filterAndRenderOrders()">
              </div>

              <select id="orderStatusFilter" class="filter-select" onchange="filterAndRenderOrders()">
                <option value="ALL">All Statuses</option>
                <option value="order pending">Order Pending</option>
                <option value="order confirmed">Order Confirmed</option>
                <option value="delivery ongoing">Delivery Ongoing</option>
                <option value="delivery success">Delivery Success</option>
                <option value="order rejected">Order Rejected</option>
                <option value="order cancelled">Order Cancelled</option>
              </select>

              <select id="orderSortSelect" class="filter-select" onchange="filterAndRenderOrders()">
                <option value="newest">Sort: Date (Newest)</option>
                <option value="oldest">Sort: Date (Oldest)</option>
                <option value="amount_desc">Amount: High to Low</option>
                <option value="amount_asc">Amount: Low to High</option>
                <option value="client_asc">Client: A → Z</option>
              </select>
            </div>
          </div>

          <div class="table-container">
            <table class="data-table">
              <thead>
                <tr>
                  <th>Order #</th>
                  <th>Client</th>
                  <th>Product</th>
                  <th>Size & Qty</th>
                  <th>Total (AED)</th>
                  <th>Status</th>
                  <th>Date</th>
                  <th style="text-align: right;">Actions</th>
                </tr>
              </thead>
              <tbody id="ordersTableBody">
                <tr><td colspan="8" class="empty-state">Loading orders...</td></tr>
              </tbody>
            </table>

            <!-- 10 Rows per page pagination -->
            <div class="pagination-footer" id="ordersPagination"></div>
          </div>
        </section>


        <!-- =================================================================
             5. PAYMENT SETUP SECTION (Collection: PAYMENT_SETUP)
             ================================================================= -->
        <section id="section-payment" class="view-section">
          <div class="card" style="max-width: 900px;">
            <div class="card-header">
              <div>
                <h3 class="card-title">Payment Configuration</h3>
                <div class="card-subtitle">Manage atelier QR code, UPI ID, GPay number and settlement bank</div>
              </div>
              <button class="btn btn-gold" onclick="savePaymentSetup()">
                <i data-lucide="save"></i>
                <span>Save Changes</span>
              </button>
            </div>

            <div class="card-body">
              <form id="paymentSetupForm" onsubmit="event.preventDefault(); savePaymentSetup();">
                <!-- QR Code Upload & Preview -->
                <div class="form-group">
                  <label class="form-label">Payment QR Code Image (&lt; 2MB)</label>
                  <div class="image-upload-box" onclick="document.getElementById('qrCodeInput').click()">
                    <i data-lucide="qr-code" style="width: 32px; height: 32px; color: var(--gold-primary); margin-bottom: 6px;"></i>
                    <div style="font-size: 0.85rem; font-weight: 500;">Click to upload QR Code image</div>
                    <div style="font-size: 0.72rem; color: var(--text-dim); margin-top: 2px;">JPG, PNG, WebP or SVG up to 2MB. Saved directly in MongoDB.</div>
                    <input type="file" id="qrCodeInput" accept="image/*" style="display: none;" onchange="handleQRImageUpload(event)">
                  </div>

                  <div id="qrCodePreviewContainer" style="margin-top: 12px; display: none; text-align: center;">
                    <img id="qrCodePreviewImg" src="" alt="Payment QR Code Preview" style="max-width: 180px; max-height: 180px; border-radius: var(--radius-sm); border: 2px solid var(--gold-border);">
                    <div style="margin-top: 6px;">
                      <button type="button" class="btn btn-secondary btn-sm" onclick="removeQRImage()">Remove QR</button>
                    </div>
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <label class="form-label">UPI ID</label>
                    <input type="text" id="paymentUpiId" class="form-input" placeholder="e.g. qalidotae@okaxis">
                  </div>
                  <div class="form-group">
                    <label class="form-label">GPay Number</label>
                    <input type="text" id="paymentGpayNumber" class="form-input" placeholder="e.g. +971 50 123 4567">
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <label class="form-label">Account Holder Name</label>
                    <input type="text" id="paymentAccountHolder" class="form-input" placeholder="e.g. QALIDOTAE LUXURY ATELIER LLC">
                  </div>
                  <div class="form-group">
                    <label class="form-label">Bank Name</label>
                    <input type="text" id="paymentBankName" class="form-input" placeholder="e.g. Emirates NBD / First Abu Dhabi Bank">
                  </div>
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <label class="form-label">Account / IBAN Number</label>
                    <input type="text" id="paymentAccountNumber" class="form-input" placeholder="e.g. AE070331234567890123456">
                  </div>
                  <div class="form-group">
                    <label class="form-label">SWIFT / IFSC Code</label>
                    <input type="text" id="paymentIfscCode" class="form-input" placeholder="e.g. EBILAEADXXX">
                  </div>
                </div>

                <div class="form-group">
                  <label class="form-label">Client Payment Instructions</label>
                  <textarea id="paymentInstructions" class="form-textarea" rows="3" placeholder="Instructions displayed to clients during checkout..."></textarea>
                </div>

                <div class="form-group" style="display: flex; align-items: center; gap: 10px;">
                  <input type="checkbox" id="paymentIsActive" style="width: 18px; height: 18px; accent-color: var(--gold-primary);">
                  <label for="paymentIsActive" style="font-size: 0.85rem; font-weight: 500; cursor: pointer;">Enable this payment configuration for client checkout</label>
                </div>
              </form>
            </div>
          </div>
        </section>


        <!-- =================================================================
             6. ADMIN ACCOUNT SECTION (Collection: ADMIN_CREDINTIALS)
             ================================================================= -->
        <section id="section-credentials" class="view-section">
          <div class="card" style="max-width: 750px;">
            <div class="card-header">
              <div>
                <h3 class="card-title">Admin Account Credentials</h3>
                <div class="card-subtitle">Manage administrative access and master login password</div>
              </div>
            </div>

            <div class="card-body">
              <form id="adminCredentialsForm" onsubmit="event.preventDefault(); saveAdminCredentials();">
                <div class="form-row">
                  <div class="form-group">
                    <label class="form-label">Display Name</label>
                    <input type="text" id="credAdminName" class="form-input" required>
                  </div>
                  <div class="form-group">
                    <label class="form-label">Admin Email Address</label>
                    <input type="email" id="credAdminEmail" class="form-input" required>
                  </div>
                </div>

                <div style="margin: 20px 0 16px; padding: 12px 16px; background: var(--bg-surface-elevated); border-radius: var(--radius-sm); border-left: 3px solid var(--gold-primary);">
                  <div style="font-size: 0.82rem; font-weight: 600; color: var(--gold-primary);">Password Update</div>
                  <div style="font-size: 0.75rem; color: var(--text-muted); margin-top: 2px;">Leave blank if you do not wish to change your password.</div>
                </div>

                <div class="form-group">
                  <label class="form-label">Current Password</label>
                  <input type="password" id="credCurrentPassword" class="form-input" placeholder="Required only if changing password">
                </div>

                <div class="form-row">
                  <div class="form-group">
                    <label class="form-label">New Password</label>
                    <input type="password" id="credNewPassword" class="form-input" placeholder="Enter new password (min 6 chars)">
                  </div>
                  <div class="form-group">
                    <label class="form-label">Confirm New Password</label>
                    <input type="password" id="credConfirmPassword" class="form-input" placeholder="Re-enter new password">
                  </div>
                </div>

                <div style="margin-top: 24px; text-align: right;">
                  <button type="submit" class="btn btn-gold">
                    <i data-lucide="shield-check"></i>
                    <span>Update Credentials</span>
                  </button>
                </div>
              </form>
            </div>
          </div>
        </section>

      </main>
    </div>
  </div>

  {{else}}
  <!-- =======================================================================
       LOGIN SCREEN (When unauthenticated)
       ======================================================================= -->
  <div class="login-container">
    <div class="login-card">
      <img src="/logo-white.png" alt="Qalidotae Logo" class="login-logo" id="loginBrandLogo">
      <h2 class="login-title">Qalidotae Atelier</h2>
      <div class="login-subtitle">Administrative Portal</div>

      <form id="adminLoginForm" onsubmit="event.preventDefault(); handleLogin();">
        <div class="form-group">
          <label class="form-label">Admin Email</label>
          <input type="email" id="loginEmail" class="form-input" placeholder="admin@qalidotae.com" required autocomplete="email">
        </div>

        <div class="form-group">
          <label class="form-label">Admin Password</label>
          <input type="password" id="loginPassword" class="form-input" placeholder="••••••••" required autocomplete="current-password">
        </div>

        <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 24px; font-size: 0.75rem; color: var(--text-muted);">
          <span>30-Day Session Protected</span>
          <span style="color: var(--gold-primary); cursor: pointer;" onclick="toggleTheme()">Theme Toggle</span>
        </div>

        <button type="submit" id="loginBtn" class="btn btn-gold btn-block">
          <i data-lucide="lock"></i>
          <span>Enter Atelier Portal</span>
        </button>
      </form>
    </div>
  </div>
  {{/if}}


  <!-- =======================================================================
       MODALS
       ======================================================================= -->

  <!-- 1. PRODUCT ADD / EDIT MODAL -->
  <div class="modal-backdrop" id="productModal">
    <div class="modal-box lg">
      <div class="modal-header">
        <h3 class="modal-title" id="productModalTitle">Add New Product</h3>
        <button class="modal-close" onclick="closeModal('productModal')"><i data-lucide="x"></i></button>
      </div>

      <div class="modal-body">
        <form id="productForm" onsubmit="event.preventDefault(); submitProductForm();">
          <input type="hidden" id="prodFormId">

          <div class="form-row">
            <div class="form-group" style="flex: 2;">
              <label class="form-label">Product Name *</label>
              <input type="text" id="prodName" class="form-input" placeholder="e.g. The Royal Emirati Thobe" required>
            </div>
            <div class="form-group" style="flex: 1;">
              <label class="form-label">Price (AED) *</label>
              <input type="number" id="prodPrice" class="form-input" min="0" step="0.01" placeholder="520" required>
            </div>
          </div>

          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Product Type / Family *</label>
              <input type="text" id="prodType" class="form-input" placeholder="e.g. Emirati Thobe, Abaya, Jalabiya, Kaftan" required>
            </div>
            <div class="form-group">
              <label class="form-label">Target Collection / Gender *</label>
              <select id="prodGender" class="form-select">
                <option value="men">Men</option>
                <option value="women">Women</option>
                <option value="unisex">Unisex</option>
              </select>
            </div>
            <div class="form-group">
              <label class="form-label">Total Stock Units *</label>
              <input type="number" id="prodStock" class="form-input" min="0" value="10" required>
            </div>
          </div>

          <!-- Front & Back Images (< 2MB, stored in Mongo Base64) -->
          <div class="form-row">
            <div class="form-group">
              <label class="form-label">Front Image (&lt; 2MB in MongoDB) *</label>
              <div class="image-upload-box" onclick="document.getElementById('prodFrontInput').click()">
                <i data-lucide="image" style="width: 24px; height: 24px; color: var(--gold-primary);"></i>
                <div style="font-size: 0.78rem; margin-top: 4px;">Upload Front Image</div>
                <input type="file" id="prodFrontInput" accept="image/*" style="display: none;" onchange="handleProductImageUpload(event, 'front')">
              </div>
              <div id="prodFrontPreviewWrap" class="preview-img-container" style="display: none;">
                <img id="prodFrontPreview" src="" alt="Front Image Preview" class="preview-img">
                <button type="button" class="btn btn-secondary btn-sm" style="display: block; margin: 4px auto 0;" onclick="removeProductImage('front')">Remove</button>
              </div>
