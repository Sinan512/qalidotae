<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{{title}}</title>
    <meta
      name="description"
      content="Qalid — a luxury thobe atelier. Premium fabric, hand-finished embroidery and an elegant fit, presented as a cinematic product launch."
    />

    <!-- Premium type pairing: serif display + clean sans -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:wght@300;400;500&family=Inter:wght@300;400;500&display=swap"
      rel="stylesheet"
    />

    <meta property="og:type" content="website">
    <meta property="og:title" content="Qalid">
    <meta property="og:description" content="Luxury Arabic Fashion & Premium Thobes">
    <meta property="og:url" content="https://qalidotae-elegant-arabic-fashion.vercel.app/">
    <meta property="og:image" content="https://qalidotae-elegant-arabic-fashion.vercel.app/logo.png">

    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content="Qalid">
    <meta name="twitter:description" content="Luxury Arabic Fashion & Premium Thobes">
    <meta name="twitter:image" content="https://qalidotae-elegant-arabic-fashion.vercel.app/logo.png">

    <link rel="icon" href="/logo-white.png" />
    <link rel="apple-touch-icon" href="/logo-white.png" />

    <!-- Hero asset preloads -->
    <link rel="preload" as="image" href="/logo.png" />

    <!-- GSAP must load before modules so gsap/ScrollTrigger are globals -->
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/ScrollTrigger.min.js"></script>

    <!--
      Import map MUST appear before any type="module" script.
      Placed here (after GSAP sync scripts, before module entry) so the
      browser registers it before resolving bare "three" specifiers.
    -->
    <script type="importmap">
      {
        "imports": {
          "three": "https://cdn.jsdelivr.net/npm/three@0.164.1/build/three.module.js",
          "three/addons/": "https://cdn.jsdelivr.net/npm/three@0.164.1/examples/jsm/"
        }
      }
    </script>

    <link rel="stylesheet" href="/stylesheets/style.css" />
  </head>
  <body>
    {{{body}}}

    <!-- Application entry point (ESM module, deferred by nature) -->
    <script type="module" src="/javascripts/main.js"></script>
  </body>
</html>
