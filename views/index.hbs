      </a>
      <a data-mail-link href="#" aria-label="Email">
        <svg viewBox="0 0 24 24" width="18" height="18" aria-hidden="true"><path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm.9 2 8.1 5.4L20.1 7H3.9ZM20 9.3l-8 5.3-8-5.3V17h16V9.3Z"/></svg>
      </a>
    </div>
    <p class="footer__copy">&copy; <span id="year"></span> Qalid. All rights reserved.</p>
    <button class="footer__top" id="backToTop" type="button">Back to top</button>
  </div>
</footer>
