{{!--
  Qalid landing page — one continuous scroll-driven story.
  Scene order: opening logo -> hero dress -> showcase -> packaging -> collection -> contact -> footer
--}}

<!-- Loading state for the GLB assets (removed once models are ready) -->
<div class="loader" id="loader" aria-hidden="true">
  <span class="loader__bar"><span class="loader__fill" id="loaderFill"></span></span>
</div>

<!-- ============================ NAVBAR ============================ -->
<header class="nav" id="nav">
  <div class="nav__inner">
    {{!-- The flying opening logo lands exactly on this slot (Scene 1), then the
          real mark inside it takes over so it stays put on scroll/resize. --}}
    <div class="nav__logoSlot" id="navLogoSlot">
      <img src="/logo.png" alt="Qalid" class="nav__logo" id="navLogo" width="46" height="46" />
    </div>
    <nav class="nav__links" id="navLinks" aria-label="Primary">
      <a href="#showcase">Craft</a>
      <a href="#packaging">Packaging</a>
      <a href="#collection">Collection</a>
      <a href="#contact">Contact</a>
    </nav>
  </div>
</header>

<!-- ========================= SCENE 1 — OPENING ===================== -->
<section class="opening" id="opening">
  <img
    src="/logo.png"
    alt="Qalid"
    class="opening__logo"
    id="heroLogo"
    width="240"
    height="240"
    decoding="async"
  />
  <span class="opening__hint" id="openingHint">Scroll</span>
</section>

<!-- ============ SCENES 2–4 — PINNED 3D STAGE (dress + box) ========= -->
<div class="stage" id="stage">
  <div class="stage__viewport" id="stageViewport">
    <canvas id="scene" class="stage__canvas"></canvas>

    {{!-- Scene 2 caption --}}
    <div class="stage__hero" id="heroCopy">
      <p class="eyebrow">The Atelier</p>
      <h1 class="display">A thobe, <em>reimagined</em></h1>
      <p class="lede">Suspended in stillness. Cut for movement.</p>
    </div>

    {{!-- Scene 3 copy blocks, revealed in sync with the rotation --}}
    <div class="stage__panels" id="showcase">
      <article class="panel" data-panel="0">
        <span class="panel__index">01</span>
        <h2>Premium Fabric</h2>
        <p>A long-staple weave, brushed to a quiet matte lustre that falls without effort.</p>
      </article>
      <article class="panel" data-panel="1">
        <span class="panel__index">02</span>
        <h2>Luxury Embroidery</h2>
        <p>Hand-guided stitching along the placket — restrained, deliberate, unmistakable.</p>
      </article>
      <article class="panel" data-panel="2">
        <span class="panel__index">03</span>
        <h2>Comfortable Fit</h2>
        <p>Shoulders drafted from the body outward, so the silhouette breathes as you move.</p>
      </article>
      <article class="panel" data-panel="3">
        <span class="panel__index">04</span>
        <h2>Elegant Finish</h2>
        <p>Bound seams, weighted hem, and a collar that holds its line all day.</p>
      </article>
    </div>

    {{!-- Scene 4 caption --}}
    <div class="stage__pack" id="packaging">
      <p class="eyebrow">Presentation</p>
      <h2 class="display">Folded, boxed, <em>yours</em></h2>
      <p class="lede">Each piece is folded by hand and set into the Qalid box.</p>
    </div>
  </div>
</div>

<!-- ==================== SCENE 5 — COLLECTION ====================== -->
<section class="collection" id="collection">
  <div class="collection__head">
    <p class="eyebrow">The Collection</p>
    <h2 class="display">Every piece, in sequence</h2>
  </div>
  <div class="collection__track" id="galleryTrack">
    {{#each products}}
      <figure class="card" data-card>
        <img
          src="{{this.url}}"
          alt="{{this.alt}}"
          loading="lazy"
          decoding="async"
          width="900"
          height="1200"
        />
        <figcaption>{{this.name}}</figcaption>
      </figure>
    {{else}}
      <p class="collection__empty">Collection imagery coming soon.</p>
    {{/each}}
  </div>
</section>

<!-- ====================== SCENE 6 — CONTACT ======================= -->
<section class="contact" id="contact">
  <p class="eyebrow reveal">Get in touch</p>
  <h2 class="display reveal">Speak with the atelier</h2>

  <ul class="contact__list">
    <li class="reveal">
      <a data-wa-link href="#" target="_blank" rel="noopener">
        <span class="contact__label">WhatsApp</span>
        <span class="contact__value" data-wa-display></span>
      </a>
    </li>
    <li class="reveal">
      <a data-mail-link href="#">
        <span class="contact__label">Email</span>
        <span class="contact__value" data-mail-display></span>
      </a>
    </li>
    <li class="reveal">
      <a data-ig-link href="#" target="_blank" rel="noopener">
        <span class="contact__label">Instagram</span>
        <span class="contact__value" data-ig-display></span>
      </a>
    </li>
  </ul>

  <a class="btn reveal" data-wa-link href="#" target="_blank" rel="noopener">Contact us</a>
</section>

<!-- ======================= SCENE 7 — FOOTER ======================= -->
<footer class="footer">
