
<html lang="en" data-theme="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Error {{error.status}} — {{message}}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,300;0,400;0,600;1,400&family=Inter:wght@300;400;500;600&display=swap"
      rel="stylesheet"
    />
    <style>
      *,
      *::before,
      *::after {
        box-sizing: border-box;
        margin: 0;
        padding: 0;
      }

      :root {
        --font-display: "Cormorant Garamond", Georgia, serif;
        --font-sans:
          "Inter", -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto,
          sans-serif;
        --transition-smooth: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
        --transition-slow: all 0.45s cubic-bezier(0.16, 1, 0.3, 1);
        --radius-sm: 4px;
        --radius-md: 8px;
        --radius-lg: 14px;
        --radius-full: 9999px;
        --shadow-sm: 0 2px 8px rgba(0, 0, 0, 0.08);
        --shadow-md: 0 8px 24px rgba(0, 0, 0, 0.12);
        --shadow-lg: 0 16px 48px rgba(0, 0, 0, 0.22);
        --gold-primary: #d4af37;
        --gold-light: #f3e5ab;
        --gold-dark: #aa851c;
        --gold-gradient: linear-gradient(135deg, #d4af37 0%, #aa851c 100%);
      }

      html[data-theme="dark"] {
        --bg-body: #0a0a0d;
        --bg-surface: #121217;
        --bg-surface-elevated: #181820;
        --bg-surface-card: #14141a;
        --border-color: rgba(255, 255, 255, 0.08);
        --border-color-focus: rgba(212, 175, 55, 0.5);
        --text-main: #f5f5f7;
        --text-secondary: #a1a1aa;
        --text-dim: #71717a;
        --badge-bg: rgba(212, 175, 55, 0.12);
        --badge-text: #e8d08d;
        --card-hover-border: rgba(212, 175, 55, 0.35);
      }

      html[data-theme="light"] {
        --bg-body: #f8f6f0;
        --bg-surface: #ffffff;
        --bg-surface-elevated: #ffffff;
        --bg-surface-card: #ffffff;
        --border-color: rgba(0, 0, 0, 0.08);
        --border-color-focus: rgba(170, 133, 28, 0.5);
        --text-main: #141416;
        --text-secondary: #52525b;
        --text-dim: #71717a;
        --badge-bg: rgba(170, 133, 28, 0.1);
        --badge-text: #966f0e;
        --card-hover-border: rgba(170, 133, 28, 0.35);
      }

      body {
        font-family: var(--font-sans);
        background-color: var(--bg-body);
        color: var(--text-main);
        line-height: 1.5;
        min-height: 100vh;
        display: flex;
        flex-direction: column;
        transition:
          background-color 0.3s ease,
          color 0.3s ease;
      }

      a {
        color: inherit;
        text-decoration: none;
      }

      button {
        font-family: inherit;
        color: inherit;
        border: none;
        outline: none;
        background: none;
        cursor: pointer;
      }

      .error-page {
        flex: 1;
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 48px 24px;
        background: linear-gradient(
          180deg,
          var(--bg-surface) 0%,
          var(--bg-body) 100%
        );
      }

      .error-card {
        width: 100%;
        max-width: 720px;
        background: var(--bg-surface-card);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: 56px 48px;
        text-align: center;
        box-shadow: var(--shadow-lg);
        transition: var(--transition-smooth);
      }

      .error-card:hover {
        border-color: var(--card-hover-border);
      }

      .error-status {
        display: inline-flex;
        align-items: center;
        justify-content: center;
        min-width: 80px;
        padding: 10px 20px;
        margin-bottom: 24px;
        background: var(--badge-bg);
        color: var(--badge-text);
        font-family: var(--font-display);
        font-size: 2.4rem;
        font-weight: 300;
        line-height: 1;
        border-radius: var(--radius-full);
        border: 1px solid rgba(212, 175, 55, 0.2);
      }

      .error-title {
        font-family: var(--font-display);
        font-size: clamp(2rem, 5vw, 3rem);
        font-weight: 300;
        line-height: 1.1;
        letter-spacing: 0.02em;
        color: var(--text-main);
        margin-bottom: 16px;
      }

      .error-message {
        font-size: 1.05rem;
        font-weight: 300;
        color: var(--text-secondary);
        max-width: 520px;
        margin: 0 auto 36px;
        line-height: 1.6;
      }

      .error-actions {
        display: flex;
        align-items: center;
        justify-content: center;
        gap: 16px;
        flex-wrap: wrap;
        margin-bottom: 40px;
      }

      .btn-gold {
        background: var(--gold-gradient);
        color: #000000;
        font-weight: 600;
        font-size: 0.85rem;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 13px 28px;
        transition: var(--transition-smooth);
        box-shadow: 0 4px 16px rgba(212, 175, 55, 0.25);
        display: inline-flex;
        align-items: center;
        gap: 8px;
      }

      .btn-gold:hover {
        transform: translateY(-2px);
        box-shadow: 0 6px 24px rgba(212, 175, 55, 0.4);
      }

      .btn-outline {
        border: 1px solid var(--border-color);
        color: var(--text-main);
        font-size: 0.85rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        padding: 13px 28px;
        transition: var(--transition-smooth);
        background: var(--bg-surface);
      }

      .btn-outline:hover {
        border-color: var(--gold-primary);
        color: var(--gold-primary);
      }

      .error-details {
        max-width: 560px;
        margin: 0 auto;
        text-align: left;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        background: var(--bg-surface-elevated);
        overflow: hidden;
      }

      .error-details summary {
        list-style: none;
        padding: 16px 20px;
        font-size: 0.8rem;
        font-weight: 500;
        letter-spacing: 0.1em;
        text-transform: uppercase;
        color: var(--text-secondary);
        cursor: pointer;
        display: flex;
        align-items: center;
        justify-content: space-between;
        transition: var(--transition-smooth);
        user-select: none;
      }

      .error-details summary::-webkit-details-marker {
        display: none;
      }

      .error-details summary::after {
        content: "+";
        font-size: 1.2rem;
        color: var(--gold-primary);
        transition: transform 0.25s ease;
      }

      .error-details[open] summary::after {
        content: "−";
      }

      .error-details summary:hover {
        color: var(--text-main);
        background: rgba(212, 175, 55, 0.06);
      }

      .error-stack {
        padding: 0 20px 20px;
        font-family: "SF Mono", Monaco, Inconsolata, "Fira Code", monospace;
        font-size: 0.82rem;
        line-height: 1.7;
        color: var(--text-dim);
        white-space: pre-wrap;
        word-break: break-word;
        max-height: 320px;
        overflow-y: auto;
      }

      @media (max-width: 640px) {
        .error-card {
          padding: 40px 24px;
        }

        .error-status {
          font-size: 2rem;
          padding: 8px 16px;
        }

        .error-actions {
          flex-direction: column;
          width: 100%;
        }

        .error-actions .btn-gold,
        .error-actions .btn-outline {
          width: 100%;
          justify-content: center;
        }
      }
    </style>
  </head>
  <body>
    <main class="error-page">
      <article class="error-card">
        <div class="error-status">{{error.status}}</div>
        <h1 class="error-title">Something went wrong</h1>
        <p class="error-message">{{message}}</p>

        <div class="error-actions">
          <button class="btn-outline" onclick="history.back()">Go Back</button>
          <a href="/" class="btn-gold">Home</a>
        </div>

        <details class="error-details">
          <summary>Error Details</summary>
          <pre class="error-stack">{{error.stack}}</pre>
        </details>
      </article>
    </main>
  </body>
</html>